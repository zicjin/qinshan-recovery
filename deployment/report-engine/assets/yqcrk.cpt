<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT  teer.RENTUSER AS 领用人,
teer.BACKUSER AS 归还人,
teer.confirmusername 确认人,
teer.accessory 配件,
to_char(teer.RENTDATE,'yyyy-mm-dd ') || teer.RENTTIME AS 出库时间,
to_char(teer.BACKDATE,'yyyy-mm-dd ') || teer.BACKTIME AS 归还时间,
CASE WHEN RENTSTATUS = '1' THEN '正常' ELSE '异常' END AS 出库状态,
CASE WHEN BACKSTATUS = '1' THEN '正常' 
WHEN BACKSTATUS IS NULL THEN '未入库' ELSE '异常' END AS 入库状态,
teer.REMARK AS 备注,
tee.EQUIPTID AS 设备编号,
teer.PROJNOS AS 任务单号
FROM T_EMC_EQUIPT_REQUISITION teer 
INNER JOIN T_EMC_EQUIPT tee ON teer.EQUIPTID = tee.ID 
LEFT JOIN t_core_user tcu ON TCU.PARENTORGID =tee.orgid
WHERE 
tcu.id='${userid}'
AND to_char(teer.RENTDATE,'yyyy-mm-dd') >= '${start}'
AND to_char(teer.RENTDATE,'yyyy-mm-dd') <= '${end}'
AND tee.EQUIPTID IS NOT NULL 
AND teer.RENTUSER NOT LIKE '%管理%'
ORDER BY teer.RENTDATE]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
