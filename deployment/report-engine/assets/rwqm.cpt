<TableDataMap>
<TableData name="人员签名" class="com.fr.data.impl.DBTableData">
<Parameters>
<Parameter>
<Attributes name="orgId"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="isqm"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="gh"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[select 
tco.ORGNAME,
tee.USERNAME,
nvl2(tee.ELECTRONICSIGNATURE,'有','无') as 是否有签名,
tee.ELECTRONICSIGNATURE as 签名
from t_emc_emp tee 
left join t_core_org tco on tee.ORGID =tco.ID 
where 1=1
and tco.ORGNAME ='${orgId}'
${if(isqm,"and tee.ELECTRONICSIGNATURE is null","")}
${if(len(gh)==0,"","and tee.id='"+gh+"'")}
-- order by tco.ID ]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
