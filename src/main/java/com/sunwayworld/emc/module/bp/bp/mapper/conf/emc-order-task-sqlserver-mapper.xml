<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.bp.bp.mapper.EmcOrderTaskMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       P.STATUS PROJSTATUS,
                       P.PROJNO,
                       P.PROJNAME,
                       P.ORGID,
                       E.ORDERNO,
                       E.LABELNO,
                       E.ORDERDESC,
                       E.SAMPLEBEGINDATE,
                       E.SAMPLEBEGINTIME,
                       E.PARENTORDERNO,
                       E.ACCEPTEDDATE,
                       H.MONITORPOINTNAME,
                       H.FOLDERNO,
                       H.SAMPLEORGID,
                       W.INDEXNAME,
                       W.INDEX1,
                       W.INDEX2,
                       W.INDEX3,
                       W.INDEX4,
                       W.INDEX5,
                       W.INDEX6,
                       S.EQUIPTNAME,
                       S.FACTORYNO,
                       S.SPECIFICATION,
                       S.EQUIPTID AS EQUIPTSID,
                       E.REMARK,
                       E.SAMPLEID
                  FROM T_EMC_ORDER_TASK A
                  LEFT JOIN T_EMC_ORDER E
                    ON A.ORDERID = E.ID
                  LEFT JOIN T_EMC_FOLDER H
                    ON A.FOLDERID = H.ID
                  LEFT JOIN T_EMC_ORDER_INDEX W
                    ON A.INDEXID = W.ID
                  LEFT JOIN T_EMC_PROJECT P
                    ON A.PROJID = P.ID
                  LEFT JOIN T_EMC_EQUIPT S
                    ON S.ID = A.EQUIPTID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <include refid="com.sunwayworld.emc.module.bp.project.project.mapper.EmcProjectMapper.projectStatusWhereClause">
                <property name="tableAlias" value="T"/>
                <property name="projectIdColumnName" value="PROJID"/>
            </include>
            <if test='runId == "empty"'>
                AND (RUNID IS NULL OR RUNID = '')
            </if>
            <if test='inputUserId != null'>
                AND (INPUTUSERID IS NULL OR CHARINDEX(',' + #{inputUserId} + ',' , ',' + T.INPUTUSERID + ',') > 0)
            </if>
            <if test='authority_org == "1"'>
                AND <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.orgAuthorityWhereClause">
                    <property name="tableAlias" value="T"/>
                    <property name="permissionColumnName" value="ANALYSISORGID"/>
                </include>
            </if>
            <if test="target_unassigned != null">
                AND EXISTS (SELECT 1
                                  FROM ${targetTable} TAR_
                                 WHERE TAR_.${targetTableIdColumn} = T.${targetIdColumn}
                                 <if test="targetFilterColumn != null">
                                     AND TAR_.${targetFilterColumn} in ( ${targetFilterValue} )
                                 </if>
                                )
            </if>
            <!-- 监测项目修改样品过滤样品测试 -->
            <if test="target_projectEdit != null">
                AND EXISTS (SELECT 1
                              FROM T_EMC_ORDER_TASK TT
                              LEFT JOIN T_EMC_ORDER_TASK_RESULT RR
                                ON TT.ID = RR.ORDERTASKID
                              LEFT JOIN T_EMC_ITEM AA
                                ON TT.TESTMETHODID = AA.TESTMETHODID
                               AND RR.ITEMID = AA.ID
                             WHERE TT.ORDERID = T.ORDERID
                             GROUP BY TT.MONITORTMPLID,
                                      TT.SCHEMENAME,
                                      TT.TESTID,
                                      TT.TESTMETHODID
                            HAVING MAX(TT.ID) = T.ID )
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.CUPNO ASC, T.ORDERNO ASC
            </otherwise>
        </choose>
    </select>

    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_ORDER_TASK T
         WHERE T.ID = #{id}
    </select>

    <select id="selectContainerInfo" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.CONTAINERGROUP,
                       A.FIXATIVE,
                       A.CONTAINERCATEGORYNAME,
                       A.CONTAINERCATEGORYID,
                       A.STORECONDITION,
                       STUFF((SELECT DISTINCT ',' + CONCAT(TESTNAME,
                                                          CASE
                                                            WHEN SUBCONTRACTORID IS NULL THEN
                                                             ''
                                                            ELSE
                                                             '(分包)'
                                                          END)
                               FROM T_EMC_ORDER_TASK T
                              WHERE (T.CONTAINERGROUP = A.CONTAINERGROUP or (T.CONTAINERGROUP is NULL and A.CONTAINERGROUP is NULL))
                                    AND (T.FIXATIVE = A.FIXATIVE or (T.FIXATIVE is NULL and A.FIXATIVE is NULL))
                                       AND (T.CONTAINERCATEGORYNAME = A.CONTAINERCATEGORYNAME or (T.CONTAINERCATEGORYNAME is NULL and A.CONTAINERCATEGORYNAME is NULL) )
                                    AND T.ORDERID = A.ORDERID                               
                                FOR XML PATH('')),
                             1,
                             1,
                             '') TESTNAME
                  FROM T_EMC_ORDER_TASK A
                 WHERE A.ORDERID = #{orderId}
                 GROUP BY A.ORDERID,
                           A.CONTAINERGROUP,
                          A.FIXATIVE,
                          A.CONTAINERCATEGORYNAME,
                          A.CONTAINERCATEGORYID,
                          A.STORECONDITION) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <!-- 样品接收页面查询容器信息时容器信息为空的不显示 -->
            <if test='orderAccept == "1"'>
                AND T.CONTAINERCATEGORYNAME IS NOT NULL
            </if>
        </where>
    </select>

    <select id="selectOrderTaskList" parameterType="map" resultType="map">
        SELECT DISTINCT T.ORDERNO,
                        T.ID,
                        T.FOLDERID,
                        T.ORDERID,
                        T.PROJID,
                        T.PARENTID,
                        T.SCHEMENAME,
                        T.TESTID,
                        T.TESTNAME,
                        T.TESTMETHODID,
                        T.TESTMETHODBASIS,
                        T.EQUIPTNAME,
                        T.METHODID,
                        T.METHODNAME,
                        T.CONTAINERCATEGORYID,
                        T.CONTAINERCATEGORYCODE,
                        T.CONTAINERCATEGORYNAME,
                        T.CONTAINERGROUP,
                        T.QCCATEGORYID,
                        T.QCCATEGORYCODE,
                        T.QCNAME,
                        T.SUBPACKAGENO,
                        T.ANALYSISTYPE,
                        T.EQUIPTID,
                        T.CUPNO,
                        T.LABELNO,
                        T.RUNID,
                        T.MONITORTMPLID,
                        T.ORDERCATEGORY,
                        T.ANALYSISUSERID,
                        T.PARTAKEUSERID,
                        T.ANALYSISORGID,
                        T.ANALYSISORGNAME,
                        T.EQUIPTACQUNO,
                        T.STOCKID,
                        T.STOCKBATCHNO,
                        T.INDEXCATEGORYID,
                        T.INPUTUSERID,
                        T.INDEXID,
                        T. STATUS,
                        T.ORDERDESC,
                        T.SAMPLEBEGINDATE,
                        T.SAMPLEBEGINTIME,
                        T.PARENTORDERNO,
                        T.MONITORPOINTNAME
          FROM (SELECT A.*,
                       B.ORDERNO,
                       B.LABELNO,
                       B.ORDERDESC,
                       B.SAMPLEBEGINDATE,
                       B.SAMPLEBEGINTIME,
                       B.PARENTORDERNO,
                       C.MONITORPOINTNAME,
                       D.EQUIPTNAME
                  FROM T_EMC_ORDER_TASK A
                  LEFT JOIN T_EMC_ORDER B
                    ON A.ORDERID = B.ID
                  LEFT JOIN T_EMC_FOLDER C
                    ON A.FOLDERID = C.ID
                  LEFT JOIN T_EMC_EQUIPT D
                    ON A.EQUIPTID = D.ID) T
                 <where>
                    <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
                    <if test='authority_org == "1"'>
                        AND <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.orgAuthorityWhereClause">
                            <property name="tableAlias" value="T"/>
                            <property name="permissionColumnName" value="ANALYSISORGID"/>
                        </include>
                    </if>
                    <if test='originalResults == "empty"'>
                        AND EXISTS (SELECT 1
                                          FROM T_EMC_ORDER_TASK_RESULT TAR_
                                         WHERE TAR_.ORDERTASKID = T.ID
                                           AND TAR_.REPORTRESULT IS NULL
                                        )
                    </if>
                </where>
    </select>

    <select id="selectOrderTaskByRunsList" parameterType="map" resultType="map">
        SELECT DISTINCT T.ORDERNO,
                        T.ID,
                        T.FOLDERID,
                        T.ORDERID,
                        T.PROJID,
                        T.PARENTID,
                        T.SCHEMENAME,
                        T.TESTID,
                        T.TESTNAME,
                        T.TESTMETHODID,
                        T.TESTMETHODBASIS,
                        T.EQUIPTNAME,
                        T.METHODID,
                        T.METHODNAME,
                        T.CONTAINERCATEGORYID,
                        T.CONTAINERCATEGORYCODE,
                        T.CONTAINERCATEGORYNAME,
                        T.CONTAINERGROUP,
                        T.QCCATEGORYID,
                        T.QCCATEGORYCODE,
                        T.QCNAME,
                        T.SUBPACKAGENO,
                        T.ANALYSISTYPE,
                        T.EQUIPTID,
                        T.CUPNO,
                        T.LABELNO,
                        T.RUNID,
                        T.MONITORTMPLID,
                        T.ORDERCATEGORY,
                        T.ANALYSISUSERID,
                        T.PARTAKEUSERID,
                        T.ANALYSISORGID,
                        T.ANALYSISORGNAME,
                        T.EQUIPTACQUNO,
                        T.STOCKID,
                        T.STOCKBATCHNO,
                        T.INDEXCATEGORYID,
                        T.INPUTUSERID,
                        T.INDEXID,
                        T. STATUS,
                        T.ORDERDESC,
                        T.SAMPLEBEGINDATE,
                        T.SAMPLEBEGINTIME,
                        T.PARENTORDERNO,
                        (
                            CASE
                            WHEN T.QCCATEGORYCODE != 'N/A' THEN
                                T.QCNAME
                            ELSE
                                CONCAT(
                                    T.ORDERCATEGORY,
                                    '_',
                                    T.MONITORPOINTNAME
                                )
                            END
                        ) AS MONITORPOINTNAME
          FROM (SELECT A.*,
                       B.ORDERNO,
                       B.LABELNO,
                       B.ORDERDESC,
                       B.SAMPLEBEGINDATE,
                       B.SAMPLEBEGINTIME,
                       B.PARENTORDERNO,
                       C.MONITORPOINTNAME,
                       D.EQUIPTNAME
                  FROM T_EMC_ORDER_TASK A
                  LEFT JOIN T_EMC_ORDER B
                    ON A.ORDERID = B.ID
                  LEFT JOIN T_EMC_FOLDER C
                    ON A.FOLDERID = C.ID
                  LEFT JOIN T_EMC_EQUIPT D
                    ON A.EQUIPTID = D.ID) T
                 <where>
                    <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
                    <if test='authority_org == "1"'>
                        AND <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.orgAuthorityWhereClause">
                            <property name="tableAlias" value="T"/>
                            <property name="permissionColumnName" value="ANALYSISORGID"/>
                        </include>
                    </if>
                    <if test='originalResults == "empty"'>
                        AND EXISTS (SELECT 1
                                          FROM T_EMC_ORDER_TASK_RESULT TAR_
                                         WHERE TAR_.ORDERTASKID = T.ID
                                           AND TAR_.REPORTRESULT IS NULL
                                        )
                    </if>
                </where>
    </select>
    
    <select id="selectRunnableList" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT DISTINCT T.TESTMETHODID,
                                T.TESTID,
                                T.TESTNAME,
                                T.METHODID,
                                T.METHODNAME,
                                T.METHODVERSIONID,
                                T.TESTMETHODBASIS,
                                T.INPUTUSERNAME,
                                T.ORDERCATEGORY,
                                T.RUNID,
                                T.INPUTUSERID,
                                T.STATUS,
                                T.ANALYSISTYPE,
                                T.ANALYSISORGID,
                                T.PROJID
                  FROM (SELECT A.*
                          FROM T_EMC_ORDER_TASK A
                          LEFT JOIN T_EMC_PROJECT P
                            ON A.PROJID = P.ID
                         WHERE (P.STATUS != 'cancel' OR P.STATUS IS NULL)
                                 <if test="orgId != null">
                                     AND P.ORGID LIKE CONCAT(#{orgId}, '%')
                                </if>
                         ) T) T
         <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test='authority_org == "1"'>
                AND <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.orgAuthorityWhereClause">
                    <property name="tableAlias" value="T"/>
                    <property name="permissionColumnName" value="ANALYSISORGID"/>
                </include>
            </if>
                AND (RUNID IS NULL OR RUNID = '')
            <if test='inputUserId != null'>
                AND (INPUTUSERID IS NULL OR CHARINDEX(',' + #{inputUserId} + ',' , ',' + T.INPUTUSERID + ',') > 0)
            </if>
            <if test='userid != null'>
                AND EXISTS (SELECT 1
                              FROM T_EMC_EMP A
                              LEFT JOIN T_EMC_CERT B
                                ON A.ID = B.EMPID
                              LEFT JOIN T_EMC_CERT_TEST_METHOD C
                                ON B.ID = C.CERTID
                             WHERE A.ID = #{userid}
                               AND (A.FILTERTEST = '1'
                               AND C.TESTID = T.TESTMETHODID
                               AND C.METHODID = T.METHODID
                               AND (B.EXPIREDATE IS NULL OR B.EXPIREDATE > GETDATE())
                               OR A.FILTERTEST = '0'
                               OR A.FILTERTEST IS NULL)
                )
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ORDERCATEGORY DESC
            </otherwise>
        </choose>
    </select>

    <select id="selectProjOrderCategoryByCondition" parameterType="map" resultType="map">
        SELECT PO.*,
               P.PROJNO,
               P.PROJNAME,
               P.CREATEDBYNAME PROJCREATEDBYNAME,
               P.TESTORGNAME,
               P.ENTRUSTORGNAME,
               BC.BIZCATEGORYNAME
          FROM (SELECT T.PROJID, T.MONITORTMPLID, T.ORDERCATEGORY
                  FROM T_EMC_ORDER_TASK T
                 WHERE T.ANALYSISTYPE = 'analysis'
                   AND T.PROJID IS NOT NULL
                   AND <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.orgAuthorityWhereClause">
                           <property name="tableAlias" value="T"/>
                           <property name="permissionColumnName" value="ANALYSISORGID"/>
                       </include>
                       <choose>
                            <when test='targetType == "analysisPretrial"'>
                                AND T.STATUS = 'released'
                            </when>
                            <when test='targetType == "analysisAudited"'>
                                AND NOT EXISTS (SELECT 1
                                           FROM T_EMC_ORDER_TASK O
                                          WHERE O.MONITORTMPLID = T.MONITORTMPLID
                                            AND O.ANALYSISORGID = T.ANALYSISORGID
                                            AND O.PROJID = T.PROJID
                                            AND O.ANALYSISTYPE = 'analysis'
                                            AND O.STATUS != 'done')
                            </when>
                            <otherwise>
                                AND NOT EXISTS (SELECT 1
                                           FROM T_EMC_ORDER_TASK O
                                          WHERE O.MONITORTMPLID = T.MONITORTMPLID
                                            AND O.ANALYSISORGID = T.ANALYSISORGID
                                            AND O.PROJID = T.PROJID
                                            AND O.ANALYSISTYPE = 'analysis'
                                            AND O.STATUS != 'released')
                            </otherwise>
                       </choose>
                 GROUP BY T.PROJID, T.MONITORTMPLID, T.ORDERCATEGORY) PO
          LEFT JOIN T_EMC_PROJECT P
            ON PO.PROJID = P.ID
          LEFT JOIN T_EMC_BIZ_CATEGORY BC
            ON P.BIZCATEGORYID = BC.ID
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test='targetType == "analysisAudited"'>
                AND EXISTS (SELECT 1
                           FROM T_EMC_REPORT R
                          WHERE PO.MONITORTMPLID = R.MONITORTMPLID
                            AND PO.PROJID = R.PROJID
                            AND R.STATUS = 'draft')
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                PO.PROJID DESC
            </otherwise>
        </choose>
    </select>

    <select id="selectOrgProjOrderCategoryByCondition" parameterType="map" resultType="com.sunwayworld.emc.module.bp.bp.bean.EmcOrderTaskBean">
        SELECT T.*
          FROM T_EMC_ORDER_TASK T
         WHERE T.ANALYSISTYPE = 'analysis'
           AND <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.orgAuthorityWhereClause">
                   <property name="tableAlias" value="T"/>
                   <property name="permissionColumnName" value="ANALYSISORGID"/>
               </include>
           AND NOT EXISTS (SELECT 1
                  FROM T_EMC_ORDER_TASK O
                 WHERE O.MONITORTMPLID = T.MONITORTMPLID
                   AND O.ANALYSISORGID = T.ANALYSISORGID
                   AND O.PROJID = T.PROJID
                   AND O.ANALYSISTYPE = 'analysis'
                   AND O.STATUS != 'released')
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.PROJID DESC
            </otherwise>
        </choose>
    </select>

    <select id="selectAnalysisDepartmentStatistics" parameterType="map" resultType="map">
        SELECT A.ANALYSISDATE,
               COUNT(*) AS TESTCOUNT
          FROM T_EMC_ORDER_TASK A
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        GROUP BY A.ANALYSISDATE
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                A.ANALYSISDATE ASC
            </otherwise>
        </choose>
    </select>

        <select id="selectPersonnelWorkloadStatistics" parameterType="map" resultType="map">
        SELECT A.ANALYSISUSERID,
               COUNT(*) AS TESTCOUNT
          FROM T_EMC_ORDER_TASK A
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        GROUP BY A.ANALYSISUSERID
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                A.ANALYSISUSERID ASC
            </otherwise>
        </choose>
    </select>


    <select id="selectRunAnalysisOrderTaskList" parameterType="map" resultType="map">
        SELECT T.TESTID,
               T.TESTNAME,
               T.ORDERNO,
               T.ORDERDESC,
               T.SAMPLEBEGINDATE,
               T.SAMPLEBEGINTIME
          FROM (SELECT A.*,
                       Q.ORDERNO,
                       Q.ORDERDESC,
                       Q.SAMPLEBEGINDATE,
                       Q.SAMPLEBEGINTIME
                  FROM T_EMC_ORDER_TASK A
                  LEFT JOIN T_EMC_PROJECT P
                    ON A.PROJID = P.ID
                  LEFT JOIN T_EMC_ORDER Q
                    ON A.ORDERID = Q.ID
                 WHERE (P.STATUS != 'cancel' OR P.STATUS IS NULL)) T
         <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test='authority_org == "1"'>
                AND <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.orgAuthorityWhereClause">
                    <property name="tableAlias" value="T"/>
                    <property name="permissionColumnName" value="ANALYSISORGID"/>
                </include>
            </if>
                AND (RUNID IS NULL OR RUNID = '')
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ORDERCATEGORY DESC
            </otherwise>
        </choose>
    </select>
</mapper>
