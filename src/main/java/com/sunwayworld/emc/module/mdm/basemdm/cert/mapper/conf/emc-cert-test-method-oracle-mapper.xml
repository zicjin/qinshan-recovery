<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.basemdm.cert.mapper.EmcCertTestMethodMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*, M.METHODNAME,M.TESTMETHODBASIS, D.TESTNAME,B.TESTCATEGORYID,B.TESTCLASS
        FROM T_EMC_CERT_TEST_METHOD T
        LEFT JOIN T_EMC_METHOD M
        ON T.METHODID = M.ID
        LEFT JOIN T_EMC_TEST D
        ON T.TESTID = D.ID
        LEFT JOIN
        T_EMC_TEST_METHOD B
        ON T.TESTMETHODID=B.ID
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test="target_unassigned != null">
                AND NOT EXISTS (SELECT 1
                                  FROM ${targetTable} TAR_
                                 WHERE TAR_.${targetMonitoringPointColumn} = T.ID
                                 <if test="targetFilterColumn != null">
                                     AND TAR_.${targetFilterColumn} = #{targetFilterValue}
                                 </if>
                                 <if test="targetFilterColumn1 != null">
                                     AND TAR_.${targetFilterColumn1} = #{targetFilterValue1}
                                 </if>
                                ) 
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include
                    refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>


    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_CERT_TEST_METHOD T
         WHERE T.ID = #{id}
    </select>

</mapper>