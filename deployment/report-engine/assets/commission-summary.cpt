<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[WITH tep AS (
SELECT 
tep.contractid,
tep.id,
tep.CONTRACTNO 合同编号,
bc.BIZCATEGORYNAME 检测类型,
CASE tep.PROJECTTYPE 
WHEN 'czwb' THEN '场调'
WHEN 'tr' THEN '土壤'
WHEN 'wf' THEN '危废'
END AS  任务分类,
tep.projno 任务号,
tep.PROJNAME 任务名称,
tep.TESTPROJECTNAME AS 项目名称,
tep.CREATEDBYNAME 登记人,
tep.ENTRUSTORGNAME 委托单位,
CASE WHEN tep.SAMPLE =1 THEN tep.TESTORGCONTACT ELSE tep.ENTRUSTORGCONTACT END AS 联系人,
CASE WHEN tep.SAMPLE =1 THEN tep.TESTORGPHONE ELSE tep.ENTRUSTORGPHONE END AS 联系电话,
tep.TESTORGNAME 受检单位,
tep.TESTORGADDRESS 地址,
tep.projsection 分析工程,
tep.customersource 客户来源,
tep.remarkone 备注1,
tep.remarktwo 备注2,
to_char(tep.ENTRUSTDATE,'yyyy-mm-dd') 任务下达日期,
to_char(tep.firstIssueDateTime,'yyyy-mm-dd') 签发日期,
to_char(tep.DELIVERYDATE,'yyyy-mm-dd') 回签日期,
tep.PROJECTPRICE 金额,
decode(tep.AMOUNTDETERM,'0','否','1','是') 金额待定,
tep.PERIOD 预计完成天数,
tep.BUSINESSUSERNAME 业务员,
tep.BELONGAREA 所属区域,
-- tep.REPORTREMARK 报告备注,
-- tep.REMARK 现场备注,
count(DISTINCT CASE WHEN teot.testname='二噁英类' AND teot.QCNAME ='N/A' THEN teot.ORDERID END) AS 二噁英类,
tep.DETECTPURPOSE 检测目的,
CASE WHEN tep.testprojects IS NOT NULL THEN tep.testprojects
ELSE teptestname.testnames END AS 检测项目
FROM t_emc_project tep
LEFT JOIN t_emc_order teo ON tep.id=teo.projid
LEFT JOIN t_emc_order_task teot ON teo.id=teot.orderid
LEFT JOIN T_EMC_BIZ_CATEGORY bc ON tep.BIZCATEGORYID =bc.id
LEFT JOIN (
	SELECT t.id,LISTAGG(t.ORDERCATEGORY||'：'||t.TESTNAME) AS testnames
	FROM 
	(
		select 
		tep.id,
		teot.ORDERCATEGORY,
		LISTAGG(DISTINCT teot.TESTNAME,'、')||'\n' AS TESTNAME 
		from T_EMC_ORDER_TASK teot
		LEFT JOIN T_EMC_PROJECT tep ON tep.id=teot.projid
		WHERE teot.QCNAME ='N/A'
		GROUP BY tep.ID,teot.ORDERCATEGORY
	)  t
	GROUP BY t.ID
) teptestname ON teptestname.ID =tep.id 
-- LEFT JOIN t_core_use tcu ON TCU.PARENTORGID =tep.orgid
WHERE 
-- tcu.id='${userid}' AND 
tep.status <> 'cancel' --AND tep.status<>'create'
${if(xddate,"and to_char(tep.ENTRUSTDATE,'yyyy-mm-dd') BETWEEN '"+begindate+"' and '"+enddate+"'","")}
${if(rkdate,"and to_char(tep.FIRSTISSUEDATETIME,'yyyy-mm-dd') BETWEEN '"+rkbegindate+"' and '"+rkenddate+"'","")}
${if(ckdate,"and to_char(tep.DELIVERYDATE,'yyyy-mm-dd') BETWEEN '"+ckbegindate+"' and '"+ckenddate+"'","")}
${if(len(contractno)==0,"","and LOWER(tep.CONTRACTNO) like '%"+LOWER(contractno)+"%'")}
${if(len(BIZCATEGORYNAME)==0,"","and bc.BIZCATEGORYNAME like '%"+BIZCATEGORYNAME+"%'")}
${if(len(reportno)==0,"","and LOWER(tep.projno) like '%"+LOWER(reportno)+"%'")}
${if(len(TESTORGNAME)==0,"","and tep.TESTORGNAME like '%"+TESTORGNAME+"%'")}
${if(len(BUSINESSUSERNAME)==0,"","and tep.BUSINESSUSERNAME like '%"+BUSINESSUSERNAME+"%'")}
${if(len(BUSINESSUSERNAME)==0,"","and tep.BUSINESSUSERNAME like '%"+BUSINESSUSERNAME+"%'")}
GROUP BY tep.contractid,tep.CONTRACTNO,tep.ID,tep.projsection,tep.SAMPLE,tep.PROJECTTYPE,tep.customersource,tep.remarkone,tep.remarktwo,tep.AMOUNTDETERM,tep.firstIssueDateTime,bc.BIZCATEGORYNAME,tep.PROJNO,tep.PROJNAME,tep.TESTPROJECTNAME,tep.CREATEDBYNAME,tep.TESTORGNAME,tep.ENTRUSTORGNAME,tep.TESTORGADDRESS,tep.ENTRUSTORGCONTACT,tep.ENTRUSTORGPHONE,tep.TESTORGCONTACT,tep.TESTORGPHONE,tep.PROJECTPRICE,tep.ENTRUSTDATE,tep.DELIVERYDATE,tep.PERIOD,tep.BUSINESSUSERNAME,tep.BELONGAREA,tep.DETECTPURPOSE,tep.testprojects,teptestname.testnames
)
SELECT 
tep.*,
tcc.clientname 客户名称, 
tcc.PREMIUMDISCOUNT 折扣,
tcc.contractcontent 合同付款要求,
tcc.projectPlace 项目地址,
REGEXP_SUBSTR(tep.所属区域, '[^/]A+', 1, 1) AS 省,
REGEXP_SUBSTR(tep.所属区域, '[^/]A+', 1, 2) AS 市,
REGEXP_SUBSTR(tep.所属区域, '[^/]A+', 1, 3) AS 区,
pay.curpay 收款金额,
invoiceproj.price 开票金额
FROM tep
LEFT JOIN t_crm_contract tcc ON tcc.contractno=tep.合同编号 
LEFT JOIN (select projid,sum(curpay) AS curpay from T_CRM_PAY_PROJECT tcpp GROUP BY tcpp.PROJID) pay ON pay.projid=to_char(tep.id)
LEFT JOIN (
SELECT 
    tcip.PROJID,
    SUM(CASE 
        WHEN REGEXP_LIKE(tcip.PRICE, '^-?[0-9]A+(\.[0-9]A+)?$') THEN TO_NUMBER(tcip.PRICE)
        ELSE 0 END
    ) AS price
FROM T_CRM_INVOICE_PROJ tcip
GROUP BY tcip.PROJID
) invoiceproj ON invoiceproj.projid=to_char(tep.id)
WHERE 1=1 
${if(kpzt=='ykp',"and invoiceproj.price is not null","")}
${if(kpzt=='wkp',"and invoiceproj.price is null","")}
${if(len(ENTRUSTORGNAME)==0,"","and tcc.clientname like '%"+ENTRUSTORGNAME+"%'")}
ORDER BY tep.合同编号,tep.检测类型,tep.任务号]]></Query>
