<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.basemdm.fixedasset.mapper.EmcFixedassetMapper">
    <select id="selectByCondition" parameterType="map"
        resultType="map">
            SELECT T.*
              FROM (SELECT A.*,B.ORGNAME as useOrgName,  C.ORGNAME as responsityOrgName
                      FROM T_EMC_FIXEDASSET A
                        LEFT JOIN T_CORE_ORG B
                        ON A.useOrgId = B.ID
                      LEFT JOIN T_CORE_ORG C
                        ON A.responsityOrgId = C.ID) T
        <where>
            <include
                refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include
                    refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>


    <!-- 查询详情 -->
    <select id="selectDetail"
        parameterType="java.lang.Long"
        resultType="map">
        SELECT T.*
        FROM T_EMC_FIXEDASSET T
        WHERE T.ID = #{id}
    </select>

</mapper>