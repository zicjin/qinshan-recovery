<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.cloud.module.train.exampaper.persistent.mapper.CoreExamPaperMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT P.*,
                       E.EXAMNAME,
                       E.EXAMDURATION,
                       E.QUESTIONMETHOD,
                       E.EXAMBEGINTIME,
                       E.EXAMENDTIME,
                       L.TOTALSCORE,
                       (L.SINGLECHOICEQTY + L.MULTIPLECHOICEQTY  + L.COMPLETIONSCORE + L.JUDGEMENTQTY + L.SHORTANSWERQTY) QUESTIONQTY
                  FROM T_CORE_EXAM_PAPER P
                  LEFT JOIN T_CORE_EXAM E
                    ON P.EXAMID = E.ID
                  LEFT JOIN T_CORE_EXAM_TMPL L
                    ON L.ID = E.EXAMTMPLID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>

</mapper>