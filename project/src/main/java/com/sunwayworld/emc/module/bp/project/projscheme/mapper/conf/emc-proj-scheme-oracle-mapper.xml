<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.bp.project.projscheme.mapper.EmcProjSchemeMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*, 
                       C.ORGNAME,
                       D.MONITORTMPLNAME,
                       D.MONITORTMPLGROUPID,
                       D.ORDERCATEGORYCODE,
                       D.MONITORPOINTCATEGORYID AS POINTCATEGORY
                  FROM T_EMC_PROJ_SCHEME A
                  LEFT JOIN T_CORE_ORG C
                    ON A.SAMPLEORGID=C.ID
                  LEFT JOIN T_EMC_MONITOR_TMPL D
                    ON A.MONITORTMPLID = D.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.FOLDERNO
            </otherwise>
        </choose>
    </select>
    
    
    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_PROJ_SCHEME T
         WHERE T.ID = #{id}
    </select>
    
</mapper>