<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.module.sys.log.mapper.CoreLogMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT
        <choose>
            <when test="select_columns != null">
                ${select_columns}
            </when>
            <otherwise>
                T.*
            </otherwise>
        </choose>
          FROM T_CORE_LOG T
         <where>
             <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
             <if test="unacceptableDuration != null">
                 AND ROUND(TO_NUMBER(T.ENDTIME - T.STARTTIME) * 24 * 60 * 60) <![CDATA[>]]> #{unacceptableDuration}
             </if>
             <if test="startTime$From != null">
                 AND T.STARTTIME <![CDATA[>=]]> TO_DATE(#{startTime$From}, 'yyyy-MM-dd')
             </if>
             <if test="startTime$To != null">
                 AND T.STARTTIME <![CDATA[<]]> TO_DATE(#{startTime$To}, 'yyyy-MM-dd') + 1
             </if>
         </where>
         ORDER BY T.ID DESC
    </select>
    
    <select id="selectDetail" resultType="map">
        SELECT T.*
          FROM T_CORE_LOG T
         WHERE T.ID = #{id}
    </select>
</mapper>