<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.equipt.equipt.mapper.EmcEquiptTestItemMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       B.ITEMNAME,
                       B.ITEMALIASNAME,
                       B.UNITNAME,
                       C.TESTID,
                       C.TESTCLASS,
                       D.TESTNAME,
                       E.METHODNAME
                  FROM T_EMC_EQUIPT_TEST_ITEM A
                  LEFT JOIN T_EMC_ITEM B
                    ON A.ITEMID = B.ID
                  LEFT JOIN T_EMC_TEST_METHOD C
                    ON B.TESTMETHODID = C.ID
                  LEFT JOIN T_EMC_TEST D
                    ON C.TESTID = D.ID
                  LEFT JOIN T_EMC_METHOD E
                    ON C.METHODID = E.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>
    
    
    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_EQUIPT_TEST_ITEM T
         WHERE T.ID = #{id}
    </select>
    
</mapper>