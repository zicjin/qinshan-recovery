<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[WITH t AS (
SELECT  
	tep.PROJNO AS 任务编号,
	tep.PROJNAME AS 任务名称,
	to_char(tep.COMPLEDATE-2,'YYYY-MM-DD') AS 项目完成期限, 
	tef.MONITORPOINTNO AS 监测点编码,
	tef.MONITORPOINTNAME AS 监测点名称,
	tef.FOLDERNO AS 点位编号,
	teo.ORDERCATEGORY AS 样品类型,
     DECODE(teo.QCNAME,'N/A','样品',teo.QCNAME) AS 质控类型,
	teo.ORDERNO AS 样品编号,
	to_char(teo.ACCEPTEDDATE,'YYYY-MM-DD') AS 接样日期,
	ter.ID AS 批号,
	nvl2(teot.SUBCONTRACTORID,teot.TESTNAME||'*',teot.TESTNAME) AS 检测项目,
	teot.methodname AS 检测方法,
	TEOIG.ITEMGROUP AS 检测因子,
	teo.TERMINATION AS 终止情况,
	CASE WHEN ter.id IS NOT NULL THEN ter.ANALYSISUSERNAME 
	ELSE teot.INPUTUSERNAME 
	END AS 分析人,
	CASE WHEN ter.id IS NULL AND teo.ACCEPTEUSERNAME IS NOT NULL THEN '未开始'
	WHEN ter.id IS NULL AND teo.ACCEPTEUSERNAME IS NULL AND (tef.TERMINATION = 0 OR teo.TERMINATION = 0)THEN '采样中'
	WHEN ter.id IS NULL AND teo.ACCEPTEUSERNAME IS NULL AND (tef.TERMINATION = 1 OR teo.TERMINATION = 1)THEN '已终止'
	WHEN ter.status='done' THEN '分析完成'
	WHEN ter.status='audit' THEN '分析审核'
	ELSE DECODE(ter.PROCESSSTATUS,'draft','未提交','approve','分析校核','draft_rejected','退回','draft_undo','未提交',ter.PROCESSSTATUS)
	END AS 状态
FROM
	T_EMC_PROJECT tep
LEFT JOIN T_EMC_FOLDER tef ON tep.ID =tef.PROJID 
LEFT JOIN T_EMC_ORDER teo ON teo.FOLDERID =tef.ID
LEFT JOIN T_EMC_ORDER_TASK teot ON teot.ORDERID =teo.ID 
LEFT JOIN T_EMC_RUN ter ON ter.ID =teot.RUNID
LEFT JOIN T_EMC_ORDER_ITEM_GROUP teoig ON TEOIG.TESTMETHODID =teot.TESTMETHODID AND teoig.ORDERID =teot.ORDERID 
where 
teot.ANALYSISTYPE = 'analysis'
and teot.SUBCONTRACTORID is null
${if(len(projno)==0,"","and tep.projno in ('"+projno+"')")}
${if(len(testName)==0,"","and teot.testName in ('"+testName+"')")}
${if(len(methodName)==0,"","and teot.methodname = '"+methodName+"'")}
ORDER BY teot.TESTNAME,teo.ORDERNO,ter.ID
)SELECT * FROM t WHERE 1=1 
${if(len(status)==0,"","and t.状态 like '"+status+"%'")}
${if(fxwc,"and t.状态 <> '分析完成'","")}]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
