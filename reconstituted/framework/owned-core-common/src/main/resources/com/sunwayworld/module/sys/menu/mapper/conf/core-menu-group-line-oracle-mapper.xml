<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.module.sys.menu.mapper.CoreMenuGroupLineMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT T.*,
                       M.MENUNAME MENUINITNAME,
                       M.HREF
                  FROM T_CORE_MENU_GROUP_LINE T
                  LEFT JOIN T_CORE_MENU M
                         ON T.MENUID = M.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent"/>
            <choose>
                <when test='parentId == "root"'>
                    <if test='childrenOnly == "0"'>
                        AND FIND_IN_SET(T.ID, getSysMenuChildIds(NULL))
                    </if>
                    <if test='childrenOnly == "1"'>
                        AND T.PARENTID IS NULL
                    </if>
                </when>
                <when test='parentId != null and parentId != "root"'>
                    <if test='childrenOnly == "0"'>
                        AND FIND_IN_SET(T.ID, getSysMenuChildIds(#{parentId}))
                    </if>
                    <if test='childrenOnly == "1"'>
                        AND T.PARENTID = #{parentId}
                    </if>
                </when>
            </choose>
        </where>
         ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ORDERNO
            </otherwise>
        </choose>
    </select>
    
    <select id="selectDetail" resultType="map">
        SELECT T.*,
               M.MENUNAME MENUINITNAME,
               M.HREF
          FROM T_CORE_MENU_GROUP_LINE T
          LEFT JOIN T_CORE_MENU M
                 ON T.MENUID = M.ID
         WHERE T.ID = #{id}
    </select>
</mapper>