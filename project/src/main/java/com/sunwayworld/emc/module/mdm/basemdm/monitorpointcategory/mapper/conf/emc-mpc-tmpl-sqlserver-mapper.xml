<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.basemdm.monitorpointcategory.mapper.EmcMpcTmplMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.* 
          FROM (SELECT A.*,
                       B.MONITORTMPLNAME,
                       C.MONITORTMPLGROUPID,
                       B.ACTIVATEDFLAG
                  FROM T_EMC_MPC_TMPL A
                  LEFT JOIN T_EMC_MONITOR_TMPL B
                    ON A.MONITORTMPLID = B.ID 
                  LEFT JOIN T_EMC_MONITOR_POINT_CATEGORY C 
                    ON A.MONITORPOINTCATEGORYID = C.ID) T 
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>
    
    
    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT A.*,
               B.MONITORTMPLNAME
          FROM T_EMC_MPC_TMPL A
          LEFT JOIN T_EMC_MONITOR_TMPL B 
            ON A.MONITORTMPLID = B.ID
         WHERE A.ID = #{id}
    </select>
    
</mapper>