</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT 
teoo.SSGFGSMC 公司,
to_char(tep.REGISTDATE,'yyyy-mm') AS 日期,
count(DISTINCT tep.PROJNO) 任务数量,
count(DISTINCT CASE WHEN  tep.sample=1 THEN tep.PROJNO END ) 采样任务数量,
count(DISTINCT CASE WHEN  tep.sample=0 THEN tep.PROJNO END ) 送样任务数量,
count(DISTINCT ter.REPORTNO) 报告数量,
count(DISTINCT CASE WHEN  tep.sample=1 THEN ter.REPORTNO END) 采样报告数量,
count(DISTINCT CASE WHEN  tep.sample=0 THEN ter.REPORTNO END) 送样报告数量
FROM T_EMC_PROJECT tep 
LEFT JOIN T_EMC_REPORT ter ON ter.PROJID =tep.ID  AND ter.REPORTNO IS NOT NULL
LEFT JOIN T_EMC_OA_ORG teoo ON teoo.SJZZBH=tep.ORGID 
WHERE teoo.SSGFGSMC IS NOT NULL 
AND to_char(tep.REGISTDATE,'yyyy')='${cxdate}'
GROUP BY teoo.SSGFGSMC,to_char(tep.REGISTDATE,'yyyy-mm')
ORDER by to_char(tep.REGISTDATE,'yyyy-mm'),任务数量 DESC]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
