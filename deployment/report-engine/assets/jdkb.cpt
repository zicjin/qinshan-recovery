<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[with tep as (SELECT
	tep.id,
	tep.PROJNO AS 任务编号,
	tep.PROJNAME AS 任务名称,
	tep.ENTRUSTORGNAME AS 委托单位,
	tep.TESTORGNAME AS 受检单位,
	tep.projType AS 任务类型,
	to_char(tep.requiredCompleteDate,'yyyy-mm-dd') AS 预计进场时间,
	tep.COMPLETEDATE AS 完成期限,
	tep.PERIOD AS 要求周期,
	tep.BUSINESSUSERNAME as 业务员,
	tep.CREATEDBYNAME AS 登记人,
	to_char(tep.CREATEDTIME,'yyyy-mm-dd') AS 登记日期, 
	tep.REMARK AS 备注
FROM
	T_EMC_PROJECT tep 
inner JOIN t_core_user tcu ON TCU.PARENTORGID =tep.orgid
where 
tcu.id='${userid}'
AND tep.PROJNODE NOT IN('报告发送','报告归档')
AND tep.STATUS NOT IN('cancel','draft','create')
${if(len(projno)==0,"","and lower(tep.projno) like lower('%"+projno+"%')")}
${if(len(projname)==0,"","and tep.projname like '%"+projnameojno+"%'")}
${if(len(entrustname)==0,"","and tep.ENTRUSTORGNAME like '%"+entrustname+"%'")}
${if(len(signName)==0,"","and tep.BUSINESSUSERNAME like '%"+signName+"%'")}
${if(len(projType)==0,"","and tep.projType like '%"+projType+"%'")}
--and rownum <30000
ORDER BY tep.PROJNO DESC
),
teo as (
SELECT 
teo.projid,
to_char(max(teo.ACCEPTEDDATE),'YYYY-MM-DD') AS 接样日期,
count(teo.id) AS 样品数量 
FROM T_EMC_ORDER teo
GROUP BY teo.projid
),
tepstatus as(
select 
	tep.id AS projid,
	CASE 
		WHEN EXISTS (SELECT 1 FROM T_EMC_FOLDER tef WHERE tef.PROJID =tep.id AND tef.status ='draft') THEN '未安排采样'
--		WHEN EXISTS (SELECT 1 FROM T_EMC_FOLDER tef WHERE tef.PROJID =tep.id AND tef.status ='draw' AND tef.TERMINATION =0) THEN '采样中'
		WHEN EXISTS (select * from T_EMC_ORDER teo WHERE teo.projid=tep.id and teo.SAMPLEID IS NULL AND teo.TERMINATION =0) THEN '采样中'
		WHEN EXISTS (select * from T_EMC_SAMPLE tes WHERE tes.projid=tep.id and tes.PROCESSSTATUS <>'done') THEN '采样中'
		WHEN EXISTS (SELECT 1 FROM T_EMC_ORDER_TASK teot WHERE teot.PROJID =tep.id AND teot.ANALYSISTYPE ='analysis' AND  teot.status IN('prelogged','logged','approve','audit')) THEN '分析中'
		WHEN tep.STATUS = 'reportEdit' THEN '报告编制'
		WHEN ter.status='reportAudit' THEN '报告审核'
		WHEN ter.status='reportIssue' THEN '报告签发'
		WHEN ter.status='reportPrint' THEN '报告打印'
		ELSE tep.PROJNODE 
	END AS 任务阶段,
	CASE
		WHEN EXISTS (SELECT 1 FROM T_EMC_FOLDER tef WHERE tef.PROJID =tep.id AND tef.status ='draft') THEN '有点位未安排采样'
		WHEN EXISTS (SELECT 1 FROM T_EMC_ORDER teo WHERE teo.PROJID =tep.id AND teo.TERMINATION =0 AND teo.SAMPLEID IS null ) THEN '有点位采样准备'		
		WHEN EXISTS (SELECT 1 FROM T_EMC_SAMPLE tes WHERE tes.PROJID =tep.id AND tes.PROCESSSTATUS IN('draft','preLogged')) THEN '采样单未提交'		
		WHEN EXISTS (SELECT 1 FROM T_EMC_SAMPLE tes WHERE tes.PROJID =tep.id AND tes.PROCESSSTATUS ='approve') THEN '采样单校核'
		WHEN EXISTS (SELECT 1 FROM T_EMC_SAMPLE tes WHERE tes.PROJID =tep.id AND tes.PROCESSSTATUS ='audit') THEN '采样单审核'
		ELSE '/'  
	END	AS 采样阶段,	
	CASE
		WHEN EXISTS (SELECT 1 FROM T_EMC_ORDER_TASK teot WHERE teot.PROJID =tep.id AND teot.ANALYSISTYPE ='analysis' AND  teot.status ='logged' AND teot.RUNID IS null) THEN '有因子未建批'		
		WHEN EXISTS (SELECT 1 FROM T_EMC_ORDER_TASK teot WHERE teot.PROJID =tep.id AND teot.ANALYSISTYPE ='analysis' AND  teot.status ='logged' AND teot.RUNID IS NOT null) THEN '有批未提交'
		WHEN EXISTS (SELECT 1 FROM T_EMC_ORDER_TASK teot WHERE teot.PROJID =tep.id AND teot.ANALYSISTYPE ='analysis' AND  teot.status ='approve') THEN '有批分析校核'	
		WHEN EXISTS (SELECT 1 FROM T_EMC_ORDER_TASK teot WHERE teot.PROJID =tep.id AND teot.ANALYSISTYPE ='analysis' AND  teot.status ='audit') THEN '有批分析审核'
	ELSE '/' END 
	AS 分析阶段
from t_emc_project tep
LEFT JOIN T_EMC_REPORT ter ON ter.projid=tep.id
WHERE 
tep.PROJNODE NOT IN('报告发送','报告归档')
AND tep.STATUS NOT IN('cancel','draft','create')
)
select 
tep.*,
teo.接样日期,teo.样品数量,
tepstatus.任务阶段,tepstatus.采样阶段,tepstatus.分析阶段
from tep
LEFT JOIN teo ON tep.id=teo.projid
LEFT JOIN tepstatus ON tepstatus.projid=tep.id
where 1=1
${if(len(projnode)==0,"","and tepstatus.任务阶段 like '%"+projnode+"%'")}
${if(issg,"and tepstatus.任务阶段 in('采样中','分析中') and sysdate-to_date(teo.接样日期,'YYYY-MM-DD')>14","")}]]></Query>
