<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.bp.subpackage.mapper.EmcSubpackageMapper">

    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       B.PROJNAME,
                       B.BIZCATEGORYID,
                       B.TESTORGNAME
                  FROM T_EMC_SUBPACKAGE A
                  LEFT JOIN T_EMC_PROJECT B
                    ON A.PROJID = B.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <!-- 筛选登录人的部门权限 -->
            <if test="org_filter != null">
                AND EXISTS (SELECT 1
                              FROM T_CORE_USER_PERMISSION UP
                             WHERE UP.PERMISSIONTYPEID = 'T_CORE_ORG'
                               AND UP.TARGETID = T.ORGID
                               AND UP.USERID = #{loginUser.id})
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>

    <select id="selectDetail" parameterType="java.lang.String" resultType="map">
        SELECT T.*
        FROM T_EMC_SUBPACKAGE T
        WHERE T.ID = #{id}
    </select>
</mapper>
