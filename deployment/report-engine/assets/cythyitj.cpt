<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT
	tep.PROJNO AS 任务编号,
	tep.PROJNAME AS 任务名称,
	ter.sampleno AS 采样单号,
	ter.SAMPLEUSERNAME AS 分析员,
	tcu.USERNAME AS 审核人,
	tcbc.CREATEDTIME AS 审核时间,
	tcbc."COMMENT" AS 审核意见,
	ter.CREATEDBYNAME as 创建人,
	ter.SAMPLESCENEUSERNAME as 实际现场负责人
FROM
	T_EMC_SAMPLE  ter 
LEFT JOIN T_EMC_PROJECT tep ON tep.id=ter.PROJID
INNER JOIN T_CORE_BPMN_COMMENT tcbc ON tcbc.TARGETID='T_EMC_SAMPLE$'||ter.ID
LEFT JOIN T_CORE_USER tcu ON tcu.id=tcbc.USERID
WHERE 
	to_char(tcbc.CREATEDTIME,'YYYY-MM-DD') between '${bgdate}' and '${enddate}'
AND tcbc.route in ('结束节点 -> 开始节点','采样审核 -> 采样互审','采样互审 -> 开始节点')
${if(len(CREATEDBYNAME)=0,"","AND ter.CREATEDBYNAME like '%"+CREATEDBYNAME+"%'")}
${if(len(SAMPLESCENEUSERNAME)=0,"","AND ter.SAMPLESCENEUSERNAME like '%"+SAMPLESCENEUSERNAME+"%'")}
ORDER BY tcbc.CREATEDTIME DESC]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
