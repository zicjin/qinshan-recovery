<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.cloud.module.monitor.monitor.persistent.mapper.CoreMonitorMessageMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*,
               T.CREATEDTIME AS FORMATTIME
          FROM T_CORE_MONITOR_MESSAGE T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>
    
    <select id="selectLastMessages" parameterType="map" resultType="map">
        SELECT T.*,
               T.CREATEDTIME AS FORMATTIME
          FROM (SELECT * 
                  FROM T_CORE_MONITOR_MESSAGE 
                 ORDER BY CREATEDTIME DESC) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            AND ROWNUM &lt;= 10
        </where>
         
    </select>
</mapper>