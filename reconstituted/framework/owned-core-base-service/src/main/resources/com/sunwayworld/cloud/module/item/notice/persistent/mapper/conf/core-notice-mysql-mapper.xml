<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.cloud.module.item.notice.persistent.mapper.CoreNoticeMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM T_CORE_NOTICE T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test='authority_audit == "1"'>
                AND <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.auditAuthorityWhereClause" />
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>
    
    <select id="selectIndexByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT T.*
                  FROM T_CORE_NOTICE T
                 WHERE (T.VALIDDATE > NOW() OR T.VALIDDATE IS NULL)
                   AND T.PROCESSSTATUS = 'done'
                   AND T.STATUS = 'normal'
                   AND (T.NOTICECATEGORY = 'whole' OR
                       (EXISTS (SELECT 1
                                   FROM T_CORE_NOTICE_PERMISSION OP_
                                  WHERE OP_.PERMISSIONTYPE = 'T_CORE_ORG'
                                    AND OP_.NOTICEID = T.ID
                                    AND <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.orgAuthorityWhereClause">
                                            <property name="tableAlias" value="OP_"/>
                                            <property name="permissionColumnName" value="TARGETID"/>
                                        </include>) OR EXISTS
                        (SELECT 1
                        FROM T_CORE_NOTICE_PERMISSION OP_
                        WHERE OP_.PERMISSIONTYPE = 'T_CORE_ORG'
                        AND OP_.NOTICEID = T.ID
                        AND OP_.TARGETID = #{loginOrgId}) OR EXISTS
                        (SELECT 1
                            FROM T_CORE_NOTICE_PERMISSION OP_
                           WHERE OP_.PERMISSIONTYPE = 'T_CORE_USER'
                             AND OP_.NOTICEID = T.ID
                             AND OP_.TARGETID = #{loginUser.id}) OR EXISTS
                        (SELECT 1
                            FROM T_CORE_NOTICE_PERMISSION OP_, T_CORE_ROLE_USER RU_
                           WHERE OP_.PERMISSIONTYPE = 'T_CORE_ROLE'
                             AND OP_.TARGETID = CAST(RU_.ROLEID AS CHAR)
                             AND OP_.NOTICEID = T.ID
                             AND RU_.USERID = #{loginUser.id})))) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>

</mapper>