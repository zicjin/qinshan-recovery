<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.basemdm.indexitem.mapper.EmcIndexItemMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.* 
          FROM T_EMC_INDEX_ITEM T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test="target_unassigned != null">
                AND NOT EXISTS (SELECT 1
                                  FROM ${targetTable} TAR_
                                 WHERE TAR_.${targetIndexItemIdColumn} = T.ID
                                 <if test="targetFilterColumn != null">
                                     AND TAR_.${targetFilterColumn} = #{targetFilterValue}
                                 </if>
                                ) 
            </if>
            <if test="indexId != null">
                AND NOT EXISTS (SELECT
                                      S.ID
                                    FROM
                                      T_EMC_INDEX_SET S,
                                      T_EMC_ORDER_INDEX A
                                    WHERE
                                      S.INDEXID = A.ID
                                    AND S.INDEXITEMID = T.ID
                                    AND S.INDEXID = #{indexId}
                                )
                AND EXISTS(SELECT 1 from t_emc_index_test_item IT where IT.INDEXITEMID = t.ID)
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>
    
    
    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_INDEX_ITEM T
         WHERE T.ID = #{id}
    </select>
    
</mapper>