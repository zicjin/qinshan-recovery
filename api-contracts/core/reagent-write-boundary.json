            "body": {
              "p": {
                "reagentName": "Strict API Composition Parent",
                "reagentSpecification": "strict-spec",
                "methodId": 42,
                "remark": "strict-api-parent"
              }
            },
            "expected_status": 200,
            "assert": {
              "json_keys": [
                "id"
              ]
            }
          }
        ],
        "restore_requests": [
          {
            "id": "reagent-restore",
            "method": "DELETE",
            "path": "/secure/core/module/bp/reagents",
            "body": {
              "ids": [
                "${fixture.reagent-create.id}"
              ]
            },
            "expected_status": 200,
            "assert": {
              "json_keys": [
                "deleted"
              ]
            }
          }
        ],
        "business_write_via": "http"
      },
      "audit": {
        "required": true,
        "status": "observed",
        "event": "reagent-composition-insert",
        "outcome": "ALLOWED",
        "source": "owned-http"
      },
      "route_origin": "owned-java-source-only",
      "boundary_semantics": "owned Java source-only route; boundary route != boundary process",
      "runtime_model": "same-spring-application"
    }
  ],
  "route_execution_model": {
    "application": "one owned Spring application per wave",
    "oracle": "one clone-derived Oracle per wave",
