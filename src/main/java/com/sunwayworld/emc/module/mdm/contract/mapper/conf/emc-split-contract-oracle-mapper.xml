<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.contract.mapper.EmcSplitContractMapper">

    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
        FROM (SELECT A.*,
                     B.CONTRACTNO,
                     B.ORGID,
                     B.ENTRUSTORGNAME,
                     B.ENTRUSTORGADDRESS,
                     B.ENTRUSTOR,
                     B.ENTRUSTORGPHONE,
                     B.SALERNAME,
                     B.SALERPHONE
                FROM T_EMC_SPLIT_CONTRACT A
              LEFT JOIN T_EMC_CONTRACT B
                ON A.CONTRACTID = B.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test="targetType == 'createProject'">
                AND NOT EXISTS (
                    SELECT 1 FROM T_EMC_PROJECT P WHERE T.ID = P.SPLITCONTRACTID
                )
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>

</mapper>
