<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.basemdm.cert.mapper.EmcCertMonitorAbilityMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.* 
          FROM (SELECT B.*, 
                       A.MONITOROBJID, 
                       A.MONITOROBJNAME, 
                       A.METHODSOURCE, 
                       A.INSTRUCTION
                 FROM T_EMC_CERT_MONITOR_ABILITY B
                   LEFT JOIN T_EMC_MONITOR_ABILITY A 
                     ON A.ID = B.MONOTORABILITYID) T
        <where>
            <include
                refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include
                    refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>


    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_CERT_MONITOR_ABILITY T
         WHERE T.ID = #{id}
    </select>

</mapper>