<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.basemdm.monitorability.mapper.EmcMonitorAbilityEquiptMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       B.EQUIPTID   AS EQUIPTIDS,
                       B.EQUIPTNAME,
                       B.STATUS,
                       C.USERNAME   AS MAINTAINUSERID,
                       B.ADDRESS,
                       D.ORGNAME    AS DEPARTMENT
                  FROM T_EMC_MONITOR_ABILITY_EQUIPT A
                  LEFT JOIN T_EMC_EQUIPT B
                    ON A.EQUIPTID = B.ID
                  LEFT JOIN T_CORE_USER C
                    ON B.MAINTAINUSERID = C.ID
                  LEFT JOIN T_CORE_ORG D
                    ON A.DEPARTMENTID = D.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>
    
    
    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_MONITOR_ABILITY_EQUIPT T
         WHERE T.ID = #{id}
    </select>
    
</mapper>