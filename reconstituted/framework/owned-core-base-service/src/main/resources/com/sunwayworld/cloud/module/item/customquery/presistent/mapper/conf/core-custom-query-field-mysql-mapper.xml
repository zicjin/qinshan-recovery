<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.cloud.module.item.customquery.presistent.mapper.CoreCustomQueryFieldMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM T_CORE_CUSTOM_QUERY_FIELD T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test="target_unassigned != null"> <!-- 查询不在某业务表下的数自定义查询字段  -->
                AND NOT EXISTS (SELECT 1
                FROM ${targetTable} TAR_
                WHERE TAR_.${targetFieldIdColumn} = T.CUSTOMQUERYID
                <if test="targetFilterColumn != null">
                    AND TAR_.${targetFilterColumn} = T.FIELDNAME
                </if>
                )
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />

            </when>
            <otherwise>
                T.ORDERNO,T.ID DESC
            </otherwise>
        </choose>
    </select>

</mapper>