<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.module.sys.at.mapper.CoreAuditTrailRecordLineMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT L.*,
                       R.AUDITTRAILTYPE,
                       R.AUDITTRAILNAME,
                       R.COMMENT
                  FROM T_CORE_AT_RECORD_LINE L, T_CORE_AT_RECORD R
                 WHERE L.RECORDID = R.ID) T
        <where>
            <!-- Supplied after caller filter extraction by the owned audit read adapter. -->
            <if test="_parameter.containsKey('ownedAuditOrgId')">
                <choose>
                    <when test="ownedAuditOrgId != null and ownedAuditOrgId != ''">
                        AND EXISTS (SELECT 1 FROM T_CORE_AT_RECORD OWNED_PARENT
                                     WHERE OWNED_PARENT.ID = T.RECORDID
                                       AND OWNED_PARENT.CREATEDBYORGID = #{ownedAuditOrgId})
                    </when>
                    <otherwise>AND 1 = 2</otherwise>
                </choose>
            </if>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>
    
    <select id="selectDetail" resultType="map">
        SELECT L.*,
               R.AUDITTRAILTYPE,
               R.AUDITTRAILNAME,
               R.COMMENT
          FROM T_CORE_AT_RECORD_LINE L, T_CORE_AT_RECORD R
         WHERE L.RECORDID = R.ID
           AND L.ID = #{id}
    </select>

    <select id="selectTableNameByRecordId" parameterType="java.lang.String" resultType="java.lang.String">
        SELECT DISTINCT T.TABLENAME
          FROM T_CORE_AT_RECORD_LINE T 
         WHERE T.RECORDID = #{recordId}
    </select>

    <select id="selectDeletedNames" resultType="com.sunwayworld.module.sys.at.bean.CoreAuditTrailRecordLineNameDTO">
        SELECT T.TARGETID, T.NEWVALUE AS NAME
          FROM T_CORE_AT_RECORD_LINE T
          JOIN (
                SELECT MAX(ID) AS ID, TARGETID
                  FROM T_CORE_AT_RECORD_LINE A
                 WHERE A.COLUMN = #{nameField}
                   AND A.RECORDTYPE != 'DELETE'
                   AND A.TARGETID IN
        <foreach collection="list" separator="," open="(" item="item" index="idx" close=")">
                       #{item}
        </foreach>
         GROUP BY TARGETID
         ) B ON T.ID = B.ID
    </select>
</mapper>