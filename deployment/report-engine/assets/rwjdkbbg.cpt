<WorkBook xmlVersion="20211223" releaseVersion="11.0.0">
<TableDataMap>
<TableData name="报告结果" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="projno"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT
	tep.PROJNO AS 任务编号,
	tep.PROJNAME AS 任务名称,
	ter.REPORTNO AS 报告编号,
	tep.REPORTEDITUSERNAME AS 报告编制人,
	tep.REPORTREVIEWERNAME AS 报告审核,
	tep.REPORTISSUEUSERNAME AS 报告签发人,
	--原本使用的DECODE(ter.PROCESSSTATUS,'draft','未提交','approve','审核中','draft_rejected','退回','done','完成',ter.PROCESSSTATUS) AS 状态
	--优化后
	decode(ter.STATUS,'reportEdit','报告编制','reportAudit','报告审核','reportIssue','报告签发','reportPrint','报告打印','reportSeal','报告发送','reportSend','报告发送','reportArchiving','报告归档','未开始编制') AS 状态
FROM
	T_EMC_PROJECT tep
LEFT JOIN T_EMC_REPORT ter ON tep.ID=ter.PROJID 
where 1=1
AND ter.REPORTNO IS NOT null
${if(len(projno)==0,"","and tep.projno like '"+projno+"%'")}]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
