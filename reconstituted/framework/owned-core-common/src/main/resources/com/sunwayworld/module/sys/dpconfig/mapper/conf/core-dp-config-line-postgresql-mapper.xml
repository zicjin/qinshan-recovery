<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.module.sys.dpconfig.mapper.CoreDpConfigLineMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT DCL.*,
                       DCM.TABLENAME,
                       DC.DPCONFIGNAME RELATECONFIGNAME,
                       DC.TABLENAME RELATECONFIGTABLENAME
                  FROM T_CORE_DP_CONFIG_LINE DCL
                  LEFT JOIN T_CORE_DP_CONFIG DC
                    ON DCL.RELATECONFIGID = DC.ID
                  LEFT JOIN T_CORE_DP_CONFIG DCM
                    ON DCL.DPCONFIGID = DCM.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>

</mapper>