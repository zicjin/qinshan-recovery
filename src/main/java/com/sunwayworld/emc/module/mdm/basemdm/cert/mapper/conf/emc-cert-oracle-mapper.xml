<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.basemdm.cert.mapper.EmcCertMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT C.*, U.USERNAME
                  FROM T_EMC_CERT C
                  LEFT JOIN T_CORE_USER U
                    ON U.ID = C.EMPID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include
                    refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>


    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_CERT T
         WHERE T.ID = #{id}
    </select>

    <!-- 证书超期提醒 -->
    <select id="selectOverdueCert" parameterType="map" resultType="map">
        SELECT T.*
          FROM T_EMC_CERT T
         WHERE T.EXPIREDATE <![CDATA[<=]]> sysdate() + T.WARNINGDAYS
         ORDER BY T.ID
    </select>


</mapper>