{
  "schema": 1,
  "family": "core-reagent-write-boundary",
  "description": "HTTP-only reagent and composition writes through the owned isolated boundary.",
  "cases": [
    {
      "id": "reagent.update.http",
      "method": "PUT",
      "path": "/secure/core/module/bp/reagents/${fixture.reagent-create.id}",
      "route_id": "d11ba07a3ab1488f",
      "operation": "write",
      "write_via": "http",
      "scope": "owned-java-source-only-route",
      "disposition": "owned-pass",
      "body": {
        "p": {
          "reagentName": "Strict API Reagent Updated",
          "remark": "strict-api-update"
        }
      },
      "expected_status": 200,
      "assert": {
        "json_keys": [
          "updated"
        ]
      },
      "fixture": {
        "id": "reagent-update-api-fixture",
        "mode": "api",
        "setup_requests": [
          {
            "id": "reagent-create",
            "capture_json": true,
            "method": "POST",
            "path": "/secure/core/module/bp/reagents",
            "body": {
              "p": {
                "reagentName": "Strict API Reagent",
                "reagentSpecification": "strict-spec",
                "methodId": 42,
                "remark": "strict-api-create"
              }
            },
            "expected_status": 200,
            "assert": {
              "json_keys": [
                "id"
              ]
            }
          }
        ],
        "restore_requests": [
          {
            "id": "reagent-restore",
            "method": "DELETE",
            "path": "/secure/core/module/bp/reagents",
            "body": {
              "ids": [
                "${fixture.reagent-create.id}"
              ]
            },
            "expected_status": 200,
            "assert": {
              "json_keys": [
                "deleted"
              ]
            }
          }
        ],
        "business_write_via": "http"
      },
      "audit": {
        "required": true,
        "status": "observed",
        "event": "reagent-update",
        "outcome": "ALLOWED",
        "source": "owned-http"
      },
      "route_origin": "owned-java-source-only",
      "boundary_semantics": "owned Java source-only route; boundary route != boundary process",
      "runtime_model": "same-spring-application"
    },
    {
      "id": "reagent.composition-insert.http",
      "method": "POST",
      "path": "/secure/core/module/bp/reagents/${fixture.reagent-create.id}/compositions",
      "route_id": "91f6594d1136e623",
      "operation": "write",
      "write_via": "http",
      "scope": "owned-java-source-only-route",
      "disposition": "owned-pass",
      "body": {
        "p": {
          "reagentName": "Strict API Component",
          "reagentFactory": "Strict Factory",
          "reagentBatchNo": "STRICT-BATCH",
          "weightVolume": "1ml",
          "remark": "strict-api-composition"
        }
      },
      "expected_status": 200,
      "assert": {
        "json_keys": [
          "id"
        ]
      },
      "fixture": {
        "id": "reagent-composition-api-fixture",
        "mode": "api",
        "setup_requests": [
          {
            "id": "reagent-create",
            "capture_json": true,
            "method": "POST",
