<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.module.admin.page.mapper.CoreAdminPageConfigMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT P.*,
                       M.MENUNAME,
                       M.HREF MENUURL
                  FROM T_CORE_ADMIN_PAGE_CONFIG P
                  LEFT JOIN T_CORE_MENU M
                    ON P.MENUID = M.ID) T
         <where>
             <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
         </where>
         ORDER BY T.ID DESC
    </select>
</mapper>