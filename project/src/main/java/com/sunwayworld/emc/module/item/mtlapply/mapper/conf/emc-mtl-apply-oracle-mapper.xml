<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.item.mtlapply.mapper.EmcMtlApplyMapper">

    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       B.MTLNAME,
                       B.SPECIFICATION,
                       B.MTLCATEGORYID,
                       B.HARMFULNESS,
                       C.BATCHNO,
                       C.STOCKQTY,
                       D.STDVALUE
                  FROM T_EMC_MTL_APPLY A
                  LEFT JOIN T_EMC_MTL B
                    ON A.MTLID = B.ID
                  LEFT JOIN T_EMC_STOCK C
                    ON A.STOCKID = C.ID
                  LEFT JOIN (
                    SELECT STOCKID,
                           STDVALUE
                      FROM T_EMC_STOCK_CONCENT M
                        WHERE NOT EXISTS
                        (SELECT 1 FROM T_EMC_STOCK_CONCENT N WHERE M.STOCKID = N.STOCKID AND N.ID <![CDATA[<]]> M.ID)
                  ) D
                    ON A.STOCKID = D.STOCKID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test='authority_audit == "1"'>
                AND <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.auditAuthorityWhereClause" />
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>

</mapper>
