<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[WITH contract AS (
	select 
		tcc.id,
		tcc.CONTRACTNO AS 合同号,
		tcc.SIGNDATE AS 合同签订日期,
		tcc.CLIENTCONTACT AS 客户联系人,
		tcc.CLIENTCONTACTPHONE AS 客户联系人电话,
		tcc.CONTRACTPRICE AS 合同金额,
		to_char(tcc.CREATEDTIME,'YYYY-MM-DD') AS 合同创建日期,
		'' AS 合同返回日期,
		'' AS 合同状态,
		tcc.BUSINESSAREA AS 所属区域,
		tcc.SIGNUSERNAME AS 签约人,
		tcc.ASSISTANT AS 业务助理,
		tcc.PREMIUMDISCOUNT AS 预计折扣,
		tcc.COMMISSIONRATE AS 提成比例,
		'' AS 邮箱,
		'' AS 业务分类,
		tcc.remark AS 备注
	from 
	t_crm_contract tcc
),
contractfb AS (
	select 
		tcpc.CONTRACTID,
		LISTAGG(tcpc.PACKINFO||':'||tcpc.AMOUNT||'\n',',') AS 预登记分包,
		LISTAGG(tcpc.PACKINFO||':'||tcpc.REALAMOUNT||'\n',',')  AS 实际记分包
	from T_CRM_CONTRACT_PACKPRICE tcpc
	GROUP BY tcpc.CONTRACTID
),
project AS (
	SELECT
		to_char(tep.id) AS id,
		tep.contractno AS 合同号,
		tep.projno AS 任务号,
		tep.ENTRUSTORGNAME AS 委托单位,
		to_char(tep.ENTRUSTDATE,'YYYY-MM-DD') AS 委托日期
	from 
	t_emc_project tep
	WHERE tep.status<>'cancel'
),
payment AS (
	SELECT
		tcpp.PROJID,
		tcpp.CURPAY AS 本次收款,
		to_char(tcp.COLLECTIONDATE,'YYYY-MM-DD') AS 收款日期
	FROM
		T_CRM_PAY_PROJECT tcpp
	LEFT JOIN T_CRM_PAYMENT tcp ON tcpp.PAYMENTID =tcp.ID
)
SELECT 
	contract.合同号,contract.合同金额,contract.合同签订日期,contract.提成比例,contract.签约人,contract.业务助理,contract.合同返回日期,contract.预计折扣,
	contractfb.实际记分包,
	project.任务号,project.委托单位,project.委托日期,
	payment.本次收款,payment.收款日期
FROM payment
inner JOIN project ON project.id=payment.projid
LEFT JOIN contract ON contract.合同号=project.合同号
LEFT JOIN contractfb ON contract.id=contractfb.CONTRACTID
WHERE 
payment.收款日期 BETWEEN '${begindate}' and '${enddate}'
${if(len(contractno)==0,"","and project.合同号 like '%"+contractno+"%'")}
${if(len(reportno)==0,"","and project.任务号 like '%"+reportno+"%'")}
${if(len(ENTRUSTORGNAME)==0,"","and project.委托单位 like '%"+ENTRUSTORGNAME+"%'")}
${if(len(BUSINESSUSERNAME)==0,"","and contract.签约人 like '%"+BUSINESSUSERNAME+"%'")}]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
