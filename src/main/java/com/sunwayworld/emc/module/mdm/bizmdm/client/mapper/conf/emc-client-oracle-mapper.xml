<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.bizmdm.client.mapper.EmcClientMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       B.AREANAME,
                       C.LXRNAME,
                       C.LXRPHONE
                  FROM T_EMC_CLIENT A
                  LEFT JOIN T_EMC_AREA B
                    ON B.ID = A.AREAID
                  LEFT JOIN T_EMC_CLIENT_CONTACT C
                    ON A.ID = C.CLIENTID AND C.ID = (SELECT MAX(ID) FROM T_EMC_CLIENT_CONTACT D WHERE A.ID=D.CLIENTID )) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ADDINDEX DESC, T.CLIENTCATEGORY
            </otherwise>
        </choose>
    </select>

    <select id="selectClientByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT DISTINCT B.MONITORPLACE,
                       A.*
                  FROM T_EMC_CLIENT A
                  LEFT JOIN T_EMC_MONITOR_POINT B
                    ON A.ID = B.CLIENTID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ADDINDEX DESC, T.CLIENTCATEGORY
            </otherwise>
        </choose>
    </select>

    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*,
               A.AREANAME
          FROM T_EMC_CLIENT T
          LEFT JOIN T_EMC_AREA A
            ON A.ID = T.AREAID
         WHERE T.ID = #{id}
    </select>

</mapper>
