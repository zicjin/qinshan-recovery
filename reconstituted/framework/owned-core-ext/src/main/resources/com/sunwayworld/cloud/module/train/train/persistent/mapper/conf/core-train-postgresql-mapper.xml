<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.cloud.module.train.train.persistent.mapper.CoreTrainMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT R.*,
                       P.THEME,
                       E.EXAMNAME
                  FROM T_CORE_TRAIN R
                  LEFT JOIN T_CORE_TRAIN_PLAN P
                    ON R.TRAINPLANID = P.ID
                  LEFT JOIN T_CORE_EXAM E
                    ON E.ID = R.EXAMID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test='queries_signable == "1"'>
                AND EXISTS(SELECT 1
                             FROM T_CORE_TRAIN_USER U
                            WHERE U.TRAINID = T.ID
                              AND U.USERID = #{loginUser.id})
            </if>
        </where>
        ORDER BY 
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID
            </otherwise>
        </choose>
    </select>
</mapper>