<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.bizmdm.test.mapper.EmcGroupItemMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       B.ACTIVATEDFLAG,
                       B.TESTMETHODID,
                       B.ITEMNAME,
                       B.ITEMALIASNAME,
                       B.REPEATITEM,
                       B.LOWLIMIT,
                       B.UNITNAME,
                       B.SCRIPT,
                       B.SCRIPTFLAG,
                       B.RESULTCATEGORY,
                       B.REVISIONRULE,
                       B.ANALYSISCATEGORY,
                       B.HIGHLIMIT,
                       B.ORDERNO,
                       B.REPORTDISPLAY,
                       B.PNFUNC,
                       B.SAMPLEPARAM,
                       C.SCHEMENAME,
                       C.INDEXCATEGORYID,
                       C.INDEXID
                  FROM T_EMC_GROUP_ITEM A
                  LEFT JOIN T_EMC_ITEM B
                    ON A.ITEMID = B.ID
                  LEFT JOIN T_EMC_PROJ_ORDER C
                    ON A.ITEMGROUPID = C.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ORDERNO
            </otherwise>
        </choose>
    </select>


    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_GROUP_ITEM T
         WHERE T.ID = #{id}
    </select>

</mapper>
