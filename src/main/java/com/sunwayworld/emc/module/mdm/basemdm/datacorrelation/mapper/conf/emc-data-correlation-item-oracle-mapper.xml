<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.basemdm.datacorrelation.mapper.EmcDataCorrelationItemMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       B.TESTCATEGORYID,
                       F.TESTCATEGORYDESC,
                       C.TESTNAME,
                       D.METHODNAME,
                       E.ITEMNAME,
                       E.ITEMALIASNAME,
                       E.LOWLIMIT,
                       E.HIGHLIMIT
                  FROM T_EMC_DATA_CORRELATION_ITEM A
                  LEFT JOIN T_EMC_TEST C
                    ON A.TESTID = C.ID
                  LEFT JOIN T_EMC_METHOD D
                    ON A.METHODID = D.ID
                  LEFT JOIN T_EMC_ITEM E
                    ON A.ITEMID = E.ID
                  LEFT JOIN T_EMC_TEST_METHOD B
                    ON A.TESTID = B.TESTID AND A.METHODID = B.METHODID
                  LEFT JOIN T_EMC_TEST_CATEGORY F
                    ON B.TESTCATEGORYID = F.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>
</mapper>