<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.module.sys.audit.mapper.CoreAuditLogMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM T_CORE_AUDIT_LOG T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID
            </otherwise>
        </choose>
    </select>
    <select id="selectTraceOverview"
            resultType="com.sunwayworld.module.sys.audit.bean.CoreAuditLogTraceOverviewDTO">
        SELECT T.TARGETTABLE, T.TARGETID, MAX(B.CREATEDTIME) AS CREATEDTIME, MIN(A.${nameField}) AS TARGETNAME
          FROM T_CORE_AUDIT_LOG T
     LEFT JOIN ${tableName} A ON T.TARGETID = A.ID
          JOIN T_CORE_AUDIT_LOG_ACTIVITY B ON T.ID = B.LOGID
         WHERE T.TARGETTABLE = #{tableName}
        <if test="targetId != null">
           AND T.TARGETID = #{targetId}
        </if>
      GROUP BY T.TARGETTABLE, T.TARGETID
      ORDER BY CREATEDTIME DESC
    </select>
</mapper>