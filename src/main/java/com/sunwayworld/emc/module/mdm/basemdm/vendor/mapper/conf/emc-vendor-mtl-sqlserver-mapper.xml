<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.basemdm.vendor.mapper.EmcVendorMtlMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT V.*,
                       A.USERNAME AS AUDITUSERNAME,
                       B.USERNAME AS AUTHORIZEUSERNAME
                  FROM T_EMC_VENDOR_MTL V
                  LEFT JOIN T_CORE_USER A
                         ON V.AUDITUSER = A.ID
                  LEFT JOIN T_CORE_USER B
                         ON V.AUTHORIZEUSER = B.ID) T
        <where>
            <include
                refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
         ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>


    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_VENDOR_MTL T
         WHERE T.ID = #{id}
    </select>
</mapper>