<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.bizmdm.indexcategory.mapper.EmcIndexSetMapper">
    
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
              FROM (SELECT S.*, 
                           A.INDEXITEMNAME,
                           D.ID AS PROPERTYDATAID,
                           D.TMPLID,
                           D.BIZID,
                           D.EXT1,
                           D.EXT2,
                           D.EXT3,
                           D.EXT4,
                           D.EXT5,
                           D.EXT6,
                           D.EXT7,
                           D.EXT8,
                           D.EXT9,
                           D.EXT10,
                           D.EXT11,
                           D.EXT12,
                           D.EXT13,
                           D.EXT14,
                           D.EXT15,
                           D.EXT16,
                           D.EXT17,
                           D.EXT18,
                           D.EXT19,
                           D.EXT20,
                           D.EXT21,
                           D.EXT22,
                           D.EXT23,
                           D.EXT24,
                           D.EXT25,
                           D.EXT26,
                           D.EXT27,
                           D.EXT28,
                           D.EXT29,
                           D.EXT30,
                           D.TABLENAME
                      FROM T_EMC_INDEX_SET S
                      LEFT JOIN T_EMC_INDEX_ITEM A
                        ON S.INDEXITEMID = A.ID
                      LEFT JOIN T_EMC_PROPERTY_DATA D 
                        ON D.BIZID = S.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY 
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.SORTNO
            </otherwise>
        </choose>
    </select>
    
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_INDEX_SET T
         WHERE T.ID = #{id}
    </select>
    
</mapper>