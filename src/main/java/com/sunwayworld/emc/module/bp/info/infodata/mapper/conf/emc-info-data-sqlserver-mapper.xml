<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.bp.info.infodata.mapper.EmcInfoDataMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
         FROM (SELECT DISTINCT A.*, B.MONITORPOINTNAME
                 FROM T_EMC_INFO_DATA A
                 LEFT JOIN T_EMC_INFO_DATA_ITEM B
                   ON B.INFODATAID = A.ID) T
        <where>
            <include
                refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
             <choose>
               <when test="year != null and month != null">
                AND CONCAT(YEAR(MONITORDATE),MONTH(MONITORDATE))= CONCAT(#{year},#{month})
               </when>
               <when test="year != null ">
                AND YEAR(MONITORDATE)=#{year}
               </when>
               <when test="month != null ">
                AND MONTH(MONITORDATE)=#{month}
               </when>
             </choose>
            
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include
                    refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>


    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_INFO_DATA T
          WHERE T.ID = #{id}
    </select>

</mapper>