<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.basemdm.monitorability.mapper.EmcMonitorAbilityMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.* 
          FROM T_EMC_MONITOR_ABILITY T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test="target_unassigned != null">
                AND NOT EXISTS (SELECT 1
                                  FROM ${targetTable} TAR_
                                 WHERE TAR_.${targetMonitorAbilityColumn} = T.ID
                                 <if test="targetFilterColumn != null">
                                     AND TAR_.${targetFilterColumn} = #{targetFilterValue}
                                 </if>
                                 <if test="targetFilterColumn1 != null">
                                     AND TAR_.${targetFilterColumn1} = #{targetFilterValue1}
                                 </if>
                                ) 
            </if>
            <if test="targetCert_unassigned != null">
                AND NOT EXISTS (SELECT 1
                                  FROM ${targetTable} TAR_
                                  LEFT JOIN T_EMC_CERT P ON TAR_.CERTID = P.ID
                                 WHERE TAR_.${targetCertMonitorAbilityColumn} = T.ID
                                 <if test="targetFilterColumn2 != null">
                                     AND TAR_.${targetCertMonitorAbilityColumn} IN
                                         (SELECT ${targetCertMonitorAbilityColumn}
                                            FROM T_EMC_CERT_MONITOR_ABILITY
                                           WHERE ${targetFilterColumn2} = #{targetFilterValue2})
                                 </if>
                                ) 
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>
    
    
    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_MONITOR_ABILITY T
         WHERE T.ID = #{id}
    </select>
    
</mapper>