<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.equipt.equipt.mapper.EmcEquiptUseRecordMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       B.TESTORGNAME,
                       B.PROJNAME,
                       D.EQUIPTID EQUIPTNO
                  FROM T_EMC_EQUIPT_USE_RECORD A
                  LEFT JOIN T_EMC_PROJECT B
                    ON A.PROJID = B.ID
                  LEFT JOIN T_EMC_EQUIPT D
                    ON A.EQUIPTID=D.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <include refid="com.sunwayworld.emc.module.bp.project.project.mapper.EmcProjectMapper.projectStatusWhereClause">
                <property name="tableAlias" value="T"/>
                <property name="projectIdColumnName" value="PROJID"/>
            </include>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include
                    refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>

</mapper>