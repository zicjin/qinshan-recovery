<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.bp.sol.mapper.EmcSolMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT S.*,
                       U.USERNAME,
                       M.SOLNAME AS volSolName
                  FROM T_EMC_SOL S
                  LEFT JOIN T_CORE_USER U
                    ON S.PREPAREUSERID = U.ID
                  LEFT JOIN T_EMC_SOL_LINE M
                    ON S.ID = M.SOLID
                    AND M.ID = (SELECT MIN(N.ID)
                                  FROM T_EMC_SOL_LINE N
                                WHERE S.ID = N.SOLID)
              ) T
        <where>
            <include
                refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include
                    refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>

</mapper>
