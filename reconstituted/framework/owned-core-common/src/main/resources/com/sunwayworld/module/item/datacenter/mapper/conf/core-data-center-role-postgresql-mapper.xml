<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.module.item.datacenter.mapper.CoreDataCenterRoleMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT DCR.*,
                       R.ROLENAME
                  FROM T_CORE_DATA_CENTER_ROLE DCR
                  LEFT JOIN T_CORE_ROLE R
                    ON DCR.ROLEID = R.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>


    <select id="selectDataCenterRoleUserByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT DCR.*,
                       RU.USERID
                  FROM T_CORE_DATA_CENTER_ROLE DCR, T_CORE_ROLE_USER RU
                 WHERE DCR.ROLEID = RU.ROLEID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID
            </otherwise>
        </choose>
    </select>
</mapper>