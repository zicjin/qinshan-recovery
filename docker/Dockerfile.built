# Reproducible owned distribution image. Pin JAVA_BASE_IMAGE by digest in the
# deployment environment; the repository contains no supplier runtime inputs.
ARG JAVA_BASE_IMAGE=eclipse-temurin:8-jre
FROM ${JAVA_BASE_IMAGE}

ENV LANG=C.UTF-8
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=/opt/java/openjdk/bin:$PATH

RUN mkdir -p /opt/lims-owned /data/LIMS/jiankeyuan/lims-czjky-emc/logs \
             /data/LIMS/jiankeyuan/lims-czjky-emc/files \
             /data/LIMS/jiankeyuan/lims-czjky-emc/index

COPY owned-distribution/target/distribution/ /opt/lims-owned/

WORKDIR /opt/lims-owned
EXPOSE 8081
ENTRYPOINT ["/opt/lims-owned/start.sh"]
CMD ["/run/secrets/lims.properties"]
