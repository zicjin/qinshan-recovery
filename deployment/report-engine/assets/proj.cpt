<?xml version="1.0" encoding="UTF-8"?>
<WorkBook xmlVersion="20211223" releaseVersion="11.0.0">
<TableDataMap>
<TableData name="基本信息" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="PROJNO"/>
<O></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[select 
tep.PROJNO AS 报告编号,
tep.ENTRUSTORGNAME AS 委托单位,
tep.ENTRUSTORGCONTACT AS 委托单位联系,
tep.ENTRUSTORGPHONE AS 委托单位电话,
tep.TESTORGNAME AS 受检单位, 
tep.TESTPROJECTNAME AS 项目名称,
tep.TESTORGADDRESS AS 受检单位地址,
tep.TESTORGCONTACT AS 受检单位联系人,
tep.TESTORGPHONE AS 受检单位联系人电话,
tec.MAIL AS 邮编,
tebc.BIZCATEGORYNAME AS 检测类型,
teoo.SSGFGSMC 公司,
CASE WHEN length(tep.DETECTPURPOSE)>0 THEN tep.DETECTPURPOSE ELSE '/' END AS 检测目的,
CONCAT(CONCAT('采样完成后,',tep.PERIOD),'个工作日内完成检测报告') AS 完成时间,
nvl2(pd.name,'项目负责人：'||pd.name||'；'||tep.REMARK,tep.REMARK) AS  备注,
tep.CREATEDBYNAME AS 下达人,
TO_CHAR(tep.ENTRUSTDATE,'yyyy"年"mm"月"dd"日"') AS 任务下达日期,
tep.BUSINESSUSERNAME AS 业务员
from T_EMC_PROJECT tep 
LEFT JOIN T_EMC_CLIENT tec ON tec.ID = tep.ENTRUSTORGID
LEFT JOIN T_EMC_BIZ_CATEGORY tebc ON tebc.BIZCATEGORYID = tep.BIZCATEGORYCODE 
LEFT JOIN T_EMC_OA_ORG teoo ON teoo.SJZZBH=tep.ORGID 
LEFT JOIN (select PROJECTID,LISTAGG(tcu.USERNAME) AS name from T_EMC_PROJECT_DIRECTOR tepd 
			LEFT JOIN T_CORE_USER tcu ON tcu.id=tepd.EMPID
			GROUP BY PROJECTID) pd ON pd.PROJECTID =tep.id
WHERE  tep.PROJNO in (
SELECT DISTINCT regexp_substr('${PROJNO}','[^,]A+',1,level) AS 参数 FROM T_EMC_PROJECT tep 
connect by level <= REGEXP_COUNT('${PROJNO}','[^,]A+')
)]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
<TableData name="点位信息" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="PROJNO"/>
<O></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[WITH t AS (
	/*采样*/
	SELECT 
	CASE WHEN tetm.MULTIPLEITEMGROUP = 1 THEN nvl2(tepo.SUBCONTRACTORID,tet.TESTNAME||'*',tet.TESTNAME) ELSE tepo.ITEMGROUP END AS "检测项目",
	tetm.MULTIPLEITEMGROUP,
	nvl2(tepo.SUBCONTRACTORID,tepo.ITEMGROUP||'*',tepo.ITEMGROUP) AS 分析项组,
	temt.MONITORTMPLNAME AS "检测类别",
	teps.monitorpointid,
	tepo.testid,
	tepo.methodid,
	to_char(teps.MONITORPOINTNAME) AS "检测地点",
	tem.METHODNAME AS "检测方法",
	to_char(teps."CYCLE") AS "周期",
	concat(CONCAT(to_char(tepo.SAMPLENUM),'*'),to_char(teps.FREQUENCY)) AS "频次",
	teps."CYCLE"*tepo.SAMPLENUM*teps.FREQUENCY AS "合计",
	to_char(teps.REMARK) AS "备注",
	tepo.SORTNUM AS "序号",
	to_char(teps.FOLDERNO) AS "点位序号",
	to_char(teic.STDNAME) AS 评价标准名称,
	CASE 
		WHEN teis.INDEXLOWLIMIT IS NULL AND teis.INDEXHIGHLIMIT IS NOT NULL THEN '≤'||teis.INDEXHIGHLIMIT||teis.unit
		WHEN teis.INDEXLOWLIMIT IS NOT NULL AND teis.INDEXHIGHLIMIT IS NULL THEN '≥'||teis.INDEXLOWLIMIT||teis.unit
		WHEN teis.INDEXLOWLIMIT IS NOT NULL AND teis.INDEXHIGHLIMIT IS NOT NULL THEN teis.INDEXLOWLIMIT||'~'||teis.INDEXHIGHLIMIT||teis.unit
	END AS 评价标准限值
	FROM T_EMC_PROJ_SCHEME teps
	LEFT JOIN T_EMC_PROJECT tep ON tep.ID = teps.PROJID 
	LEFT JOIN T_EMC_MONITOR_TMPL temt ON temt.ID = teps.MONITORTMPLID
	LEFT JOIN T_EMC_PROJ_ORDER tepo ON tepo.PROJSCHEMEID = teps.ID 
	LEFT JOIN t_emc_test tet ON tet.id=tepo.testid
	LEFT JOIN T_EMC_METHOD tem ON tepo.METHODID = tem.ID
	LEFT JOIN t_emc_test_method tetm ON tetm.TESTID = tet.ID AND tetm.METHODID = tem.ID  LEFT JOIN T_EMC_INDEX_CATEGORY teic ON teic.ID =tepo.INDEXCATEGORYID 
	LEFT JOIN (
	select teis.INDEXID,teis.INDEXITEMID,teii.INDEXITEMNAME,teiti.TESTID,teiti.METHODID,teci.CAPITEMGROUPID,teis.INDEXLOWLIMIT,teis.INDEXHIGHLIMIT ,teis.unit
	from T_EMC_INDEX_SET teis 
	LEFT JOIN T_EMC_INDEX_ITEM teii ON teis.INDEXITEMID =teii.ID
	LEFT JOIN T_EMC_INDEX_TEST_ITEM teiti ON teiti.INDEXITEMID =teii.ID
	LEFT JOIN T_EMC_CAPACITY_ITEM teci ON teci.itemid=teiti.ITEMID
	) teis ON teis.INDEXID =tepo.INDEXID AND tepo.TESTID =teis.TESTID AND tepo.methodid=teis.METHODID AND tepo.itemgroupid=teis.CAPITEMGROUPID
	WHERE tep.PROJNO in (
SELECT DISTINCT regexp_substr('${PROJNO}','[^,]A+',1,level) AS 参数 FROM T_EMC_PROJECT tep 
connect by level <= REGEXP_COUNT('${PROJNO}','[^,]A+')
)
	AND tep.SENDDATE IS NULL
),
bb AS (
/*采样多因子数量*/
	select 
		teps.FOLDERNO ,
		to_char(teps.MONITORPOINTNAME) AS MONITORPOINTNAME,
		tepo.TESTID,
		tepo.methodid,
		temt.MONITORTMPLNAME,
		count(tepo.ITEMGROUPID) AS num
	from T_EMC_PROJ_SCHEME teps 
	LEFT JOIN T_EMC_PROJ_ORDER tepo ON tepo.PROJSCHEMEID =teps.ID 
	LEFT JOIN t_emc_project tep ON tep.id=teps.projid
	LEFT JOIN T_EMC_MONITOR_TMPL temt ON temt.ID = teps.MONITORTMPLID 
	WHERE  tep.PROJNO in (
SELECT DISTINCT regexp_substr('${PROJNO}','[^,]A+',1,level) AS 参数 FROM T_EMC_PROJECT tep 
connect by level <= REGEXP_COUNT('${PROJNO}','[^,]A+')
)
	GROUP BY teps.FOLDERNO,to_char(teps.MONITORPOINTNAME),tepo.TESTID,tepo.methodid,temt.MONITORTMPLNAME
)
SELECT DISTINCT t.*,
CASE 
	WHEN bb.num != 1 THEN t.检测项目||'('||bb.num||'项)' 
	WHEN bb.num = 1 AND t.MULTIPLEITEMGROUP=1 THEN t.检测项目||'('||t.分析项组||')'||'('||bb.num||'项)'
ELSE t.分析项组||'('||bb.num||'项)' end AS 检测项目数
FROM t
LEFT JOIN bb ON  t.testid=bb.testid AND t.methodid=bb.methodid AND t.检测地点 = bb.MONITORPOINTNAME and bb.FOLDERNO=t.点位序号
WHERE 
t.testid NOT IN (1504,260,2788,1983,1984,705)/*排除烟气参数,干物质,含水率*/ 
ORDER BY t.点位序号,t.序号]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
<TableData name="有机多因子参数" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="PROJNO"/>
<O></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[WITH bb AS (
/*采样多因子数量*/
	select 
		teps.FOLDERNO ,
		to_char(teps.MONITORPOINTNAME) AS MONITORPOINTNAME,
		tepo.TESTID,
		tepo.methodid,
		temt.MONITORTMPLNAME,
		count(tepo.ITEMGROUPID) AS num
	from T_EMC_PROJ_SCHEME teps 
	LEFT JOIN T_EMC_PROJ_ORDER tepo ON tepo.PROJSCHEMEID =teps.ID 
	LEFT JOIN t_emc_project tep ON tep.id=teps.projid
	LEFT JOIN T_EMC_MONITOR_TMPL temt ON temt.ID = teps.MONITORTMPLID 
	WHERE  tep.PROJNO in (
SELECT DISTINCT regexp_substr('${PROJNO}','[^,]A+',1,level) AS 参数 FROM T_EMC_PROJECT tep 
connect by level <= REGEXP_COUNT('${PROJNO}','[^,]A+')
)
	GROUP BY teps.FOLDERNO,to_char(teps.MONITORPOINTNAME),tepo.TESTID,tepo.methodid,temt.MONITORTMPLNAME
)
SELECT 
DISTINCT 
tep2.PROJNO,tepo2.TESTID,tet.TESTNAME||'('||bb.num||'项)' as TESTNAME,tepo2.ITEMGROUP AS ITEMGROUP,tepo2.METHODID 
from T_EMC_PROJ_SCHEME teps2 
LEFT JOIN (select tepo.PROJSCHEMEID,tepo.METHODID,tepo.TESTID,LISTAGG(tepo.ITEMGROUP,'、') WITHIN GROUP (ORDER BY ITEMGROUP) AS ITEMGROUP 
from T_EMC_PROJ_ORDER tepo GROUP BY tepo.PROJSCHEMEID,tepo.METHODID,tepo.TESTID) tepo2 ON tepo2.PROJSCHEMEID =teps2.ID 
LEFT JOIN t_emc_project tep2 ON tep2.id=teps2.projid 
LEFT JOIN T_EMC_TEST tet ON tet.ID = tepo2.TESTID 
LEFT JOIN bb ON  tepo2.testid=bb.testid AND tepo2.methodid=bb.methodid AND to_char(teps2.MONITORPOINTNAME) = to_char(bb.MONITORPOINTNAME) and bb.FOLDERNO=teps2.FOLDERNO
WHERE tep2.PROJNO in (
SELECT DISTINCT regexp_substr('${PROJNO}','[^,]A+',1,level) AS 参数 FROM T_EMC_PROJECT tep 
connect by level <= REGEXP_COUNT('${PROJNO}','[^,]A+')
)
AND tepo2.TESTID IN 
(
select 
tepo.TESTID
from T_EMC_PROJ_SCHEME teps 
LEFT JOIN T_EMC_PROJ_ORDER tepo ON tepo.PROJSCHEMEID =teps.ID 
LEFT JOIN t_emc_project tep ON tep.id=teps.projid                                                                                                                                                                                                                                                                                                                                                                                                                                                        
WHERE tep.PROJNO in (
SELECT DISTINCT regexp_substr('${PROJNO}','[^,]A+',1,level) AS 参数 FROM T_EMC_PROJECT tep 
connect by level <= REGEXP_COUNT('${PROJNO}','[^,]A+')
)
GROUP BY tepo.TESTID
HAVING count(DISTINCT tepo.ITEMGROUP)>1
)
ORDER BY tep2.PROJNO,tepo2.TESTID,tepo2.METHODID]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
