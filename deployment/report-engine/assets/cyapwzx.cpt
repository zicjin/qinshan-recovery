<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[select 
tep.PROJNO AS 任务编号,
tep.PROJNAME AS 任务名称,
tef.ORDERCATEGORY AS 样品类型,
tef.MONITORPOINTNO AS 点位编号,
tef.MONITORPOINTNAME AS 点位名称,
tef.PLANSAMPLEDATE AS 计划采样日期,
tef.SCENEUSERNAME AS 现场负责人,
tef.SAMPLEUSERNAME AS 计划采样人
from T_EMC_PROJECT tep 
LEFT JOIN T_EMC_FOLDER tef ON tep.ID =tef.PROJID 
LEFT JOIN T_EMC_ORDER teo ON tef.ID =teo.FOLDERID
LEFT JOIN t_core_user tcu ON TCU.PARENTORGID =tep.orgid
WHERE 
tcu.id='${userid}'
AND tep.STATUS <>'cancel'
AND teo.SAMPLEID IS NULL 
AND tef.PLANSAMPLEDATE IS NOT NULL 
AND to_char(tef.PLANSAMPLEDATE,'YYYY-MM-DD') between '${bgdate}' and '${enddate}'
${if(len(projName)==0,"","and tep.projname like '%"+projName+"%'")}
${if(len(category)==0,"","and tef.ORDERCATEGORY like '%"+category+"%'")}
${if(len(folderName)==0,"","and tef.MONITORPOINTNAME like '%"+folderName+"%'")}
${if(len(fzName)==0,"","and tef.SCENEUSERNAME like '%"+fzName+"%'")}
ORDER BY tep.PROJNO,tef.PLANSAMPLEDATE]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
