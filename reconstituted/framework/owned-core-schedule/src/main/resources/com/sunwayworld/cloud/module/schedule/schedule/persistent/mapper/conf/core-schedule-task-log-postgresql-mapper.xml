<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.cloud.module.schedule.schedule.persistent.mapper.CoreScheduleTaskLogMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT L.*,
                       C.CONFIGNAME,
                       T.TASKNAME
                  FROM T_CORE_SCHEDULE_TASK_LOG L, T_CORE_SCHEDULE_TASK_CONFIG C, T_CORE_SCHEDULE_TASK T
                 WHERE L.CONFIGID = C.ID
                   AND C.TASKID = T.ID) T
         <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
         ORDER BY 
         <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
         </choose>
    </select>
    
    <select id="selectDetail" resultType="map">
        SELECT L.*,
               C.CONFIGNAME,
               T.TASKNAME
          FROM T_CORE_SCHEDULE_TASK_LOG L, T_CORE_SCHEDULE_TASK_CONFIG C, T_CORE_SCHEDULE_TASK T
         WHERE L.CONFIGID = C.ID
           AND C.TASKID = T.ID
           AND L.ID = #{id}
    </select>
</mapper>