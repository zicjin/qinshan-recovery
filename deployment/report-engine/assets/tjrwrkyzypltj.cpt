<?xml version="1.0" encoding="UTF-8"?>
<WorkBook xmlVersion="20211223" releaseVersion="11.0.0">
<TableDataMap>
<TableData name="ds1" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="bgdate"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="enddate"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="projno"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[select 
tep.PROJNO 任务编号,
tep.PROJNAME 任务名称,
teo.ORDERCATEGORY AS 样品类型,
teot.TESTNAME AS 检测因子,
count(DISTINCT teot.orderid) AS 样品量
from T_EMC_PROJECT tep
LEFT JOIN T_EMC_FOLDER tef ON tef.PROJID =tep.id
LEFT JOIN t_emc_order teo ON teo.FOLDERID =tef.ID
LEFT JOIN T_EMC_ORDER_TASK teot ON teot.ORDERID =teo.ID
WHERE 
tep.STATUS <>'cancel'
and tep.projno like '%${projno}%'
AND teo.QCCATEGORYCODE ='N/A'
AND to_char(tep.FIRSTISSUEDATETIME,'YYYY-MM-DD') BETWEEN '${bgdate}' AND '${enddate}'
GROUP BY tep.PROJNO,tep.PROJNAME,teo.ORDERCATEGORY,teot.TESTNAME
ORDER BY tep.PROJNO]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
<TableData name="ds2" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="enddate"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="bgdate"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="projno"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[WITH d1 AS (
select 
tep.PROJNO 任务编号,
tep.PROJNAME 任务名称,
teo.ORDERCATEGORY AS 样品类型,
teot.TESTNAME AS 检测因子,
COUNT(DISTINCT CASE WHEN teo.QCCATEGORYCODE = 'N/A' THEN teo.id END) AS 样品量,
COUNT(DISTINCT CASE WHEN teo.QCCATEGORYCODE <> 'N/A' AND teqc.USECATEGORY = 'scene' THEN teo.id END) AS QC样品量
from T_EMC_PROJECT tep
LEFT JOIN T_EMC_FOLDER tef ON tef.PROJID =tep.id
LEFT JOIN t_emc_order teo ON teo.FOLDERID =tef.ID
LEFT JOIN T_EMC_ORDER_TASK teot ON teot.ORDERID =teo.ID
LEFT JOIN T_EMC_QC_CATEGORY teqc ON teo.QCCATEGORYID = teqc.ID 
WHERE 
tep.STATUS <>'cancel'
and tep.projno like '%${projno}%'
-- AND teqc.USECATEGORY ='scene'
AND to_char(tep.FIRSTISSUEDATETIME,'YYYY-MM-DD') BETWEEN '${bgdate}' AND '${enddate}'
GROUP BY tep.PROJNO,tep.PROJNAME,teo.ORDERCATEGORY,teot.TESTNAME
-- ORDER BY tep.PROJNO
UNION   
select 
tep.PROJNO 任务编号,
tep.PROJNAME 任务名称,
teot.ORDERCATEGORY AS 样品类型,
teot.TESTNAME AS 检测因子,
COUNT(DISTINCT CASE WHEN teot.QCCATEGORYCODE = 'N/A' THEN teot.orderid END) AS 样品量,
COUNT(DISTINCT CASE WHEN teo.QCCATEGORYCODE <> 'N/A' AND teqc2.USECATEGORY IN ('lab','orderAccept') THEN teot.orderid END) AS QC样品量
FROM T_EMC_ORDER_TASK teot
inner JOIN T_EMC_RUN ter ON teot.RUNID = ter.ID 
LEFT JOIN T_EMC_PROJECT tep ON ter.PROJID = tep.ID 
LEFT JOIN T_EMC_ORDER teo ON teot.ORDERID = teo.ID 
LEFT JOIN T_EMC_QC_CATEGORY teqc2 ON teo.QCCATEGORYID = TEQC2.ID 
WHERE 
tep.STATUS <>'cancel'
and tep.projno like '%${projno}%'
-- AND teot.ANALYSISTYPE ='analysis'
AND to_char(tep.FIRSTISSUEDATETIME,'YYYY-MM-DD') BETWEEN '${bgdate}' AND '${enddate}'
GROUP BY tep.PROJNO,tep.PROJNAME,teot.ORDERCATEGORY,teot.TESTNAME
)
SELECT * FROM d1
ORDER BY 任务编号,样品类型]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
