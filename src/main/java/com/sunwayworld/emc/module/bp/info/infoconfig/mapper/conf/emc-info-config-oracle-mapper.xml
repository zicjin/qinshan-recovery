<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.bp.info.infoconfig.mapper.EmcInfoConfigMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM T_EMC_INFO_CONFIG T
        <where>
            <include
                refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test='parentId != null'>
                <choose>
                    <when test='parentId == "root"'>
                        AND T.PARENTID IS NULL
                    </when>
                    <otherwise>
                        AND T.PARENTID = #{parentId}
                    </otherwise>
                </choose>
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include
                    refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ORDERNO
            </otherwise>
        </choose>
    </select>


    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_INFO_CONFIG T
          WHERE T.ID = #{id}
    </select>
    
    <select id="selectTreeNodeList" parameterType="map" resultType="map">
        SELECT T.*
          FROM T_EMC_INFO_CONFIG T
        <where>
            <if test='parentId != null'>
                <choose>
                    <when test='parentId == "root"'>
                        AND T.PARENTID IS NULL
                    </when>
                    <otherwise>
                        AND T.PARENTID = #{parentId}
                    </otherwise>
                </choose>
            </if>
            <if test="parentIdList != null">
                AND T.PARENTID IN
                <foreach collection="parentIdList" item="parentId" open="(" close=")" separator=",">
                    #{parentId}
                </foreach>
            </if>
        </where>
         ORDER BY T.ORDERNO
    </select>
    
</mapper>