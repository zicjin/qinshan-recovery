<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.item.homeattachment.mapper.EmcHomeAttachmentMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       B.NAME FILENAME,
                       B.ID FILEID,
                       B.FILEEXT
                  FROM T_EMC_HOME_ATTACHMENT A
                  LEFT JOIN T_CORE_FILE B
                    ON B.TARGETID = ('T_EMC_HOME_ATTACHMENT$' + CAST(A.ID AS VARCHAR))) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test="targetType =='download'">
                AND EXISTS (SELECT 1
                              FROM T_EMC_HOME_ATTA_PERMISSION D
                             WHERE D.ATTACHMENTID = T.ID
                               AND D.USERID = #{loginUser.id}
                               AND T.ENDDATE >= GETDATE())
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>

</mapper>