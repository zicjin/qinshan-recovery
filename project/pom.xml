<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.sunwayworld.cloud</groupId>
        <artifactId>gikam-core-parent</artifactId>
        <version>14.1.5</version>
        <relativePath/>
    </parent>
    <artifactId>gikam-third-czjky</artifactId>
    <name>Gikam THIRD CZJKY</name>

    <!--
      2026-09-23 构建恢复调整（依据见 .scratch/sunway-supplier-exit-api-first/evidence-archive/t02-source-inventory.md 第 6 节、evidence/t02-build.md）：
      1) 依赖声明集中于重建的 gikam-core-parent:14.1.5 = 生产 run.jar BOOT-INF/lib 的固定版本
         清单（历史生成工具已迁入父仓库 migration-tooling，逐 jar sha256 见 build-support/t02-deps-manifest.sha256）。
         历史 pom 的逐项声明与生产依赖集不一致（spire.office 5.3.2→生产 8.11.3、
         com.itextpdf:kernel/layout 7.0.3→生产 itext 2.1.7 + itextpdf 5.5.13、
         gikam-core-file-default→生产 gikam-core-file-ftp、gikam-core-report-service→生产
         ...-pageoffice6、gikam-core-fr-service10.0→生产 fr-service-base/interface 等），
         不以旧声明覆盖生产依赖集。
      2) 移除 nexus 仓库与发布配置：私有 nexus 不可达（DNS 失败），依赖取得方式改为本地
         固定版本仓库；公共构建插件经 Maven Central 获取。
    -->

    <build>
        <plugins>
            <plugin>
                <!--
                    SpringBoot重新打包成可执行jar
                    原jar文件会添加后缀为.jar.original
                 -->
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.sunwayworld.emc.projectfunction.GikamWpjcApplication</mainClass>
                    <fork>false</fork>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                 Maven install前把重新打包的可执行文件的后缀改  -run.jar
                 原来的.jar.original文件去掉.original
                 -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>pre-install</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <move
                                    file="${basedir}/target/${project.artifactId}-${project.version}.${project.packaging}"
                                    tofile="${basedir}/target/${project.artifactId}-${project.version}-run.${project.packaging}" />
                                <move
                                    file="${basedir}/target/${project.artifactId}-${project.version}.${project.packaging}.original"
                                    tofile="${basedir}/target/${project.artifactId}-${project.version}.${project.packaging}" />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
