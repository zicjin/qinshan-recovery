<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.bizmdm.method.mapper.EmcMethodVersionMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       D.NAME        FILENAME,
                       D.ID          FILEID,
                       E.ELNTMPLNAME
                  FROM T_EMC_METHOD_VERSION A
                  LEFT JOIN T_CORE_FILE D
                    ON D.TARGETID = CONCAT('T_EMC_METHOD_VERSION$', A.ID)
                  LEFT JOIN T_CORE_ELN_TMPL E
                    ON A.ELNTMPLID = E.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY 
         <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.VERSIONNO DESC
            </otherwise>
         </choose>
    </select>
    
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_METHOD_VERSION T
         WHERE T.ID = #{id}
    </select>
</mapper>