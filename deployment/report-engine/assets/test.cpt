<?xml version="1.0" encoding="UTF-8"?>
<WorkBook xmlVersion="20211223" releaseVersion="11.0.0">
<TableDataMap>
<TableData name="基本信息" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="PROJNO"/>
<O></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[select 
tep.PROJNO AS 报告编号,
tep.ENTRUSTORGNAME AS 委托单位,
tep.ENTRUSTORGCONTACT AS 委托单位联系,
tep.ENTRUSTORGPHONE AS 委托单位电话,
NVL2(tep.TESTPROJECTNAME,'项目名称','受检单位名称') AS 受检单位名称, 
NVL2(tep.TESTPROJECTNAME,tep.TESTPROJECTNAME,tep.TESTORGNAME) AS 受检单位, 
tep.TESTORGADDRESS AS 受检单位地址,
tec.MAIL AS 邮编,
tebc.BIZCATEGORYNAME AS 检测类型,
CASE WHEN length(tep.DETECTPURPOSE)>0 THEN tep.DETECTPURPOSE ELSE '/' END AS 检测目的,
CONCAT(CONCAT('采样完成后,',tep.PERIOD),'个工作日内完成检测报告') AS 完成时间,
tep.REMARK AS 备注,
tep.CREATEDBYNAME AS 下达人,
TO_CHAR(tep.ENTRUSTDATE,'yyyy"年"mm"月"dd"日"') AS 任务下达日期,
tep.BUSINESSUSERNAME AS 业务员
from T_EMC_PROJECT tep 
LEFT JOIN T_EMC_CLIENT tec ON tec.ID = tep.ENTRUSTORGID
LEFT JOIN T_EMC_BIZ_CATEGORY tebc ON tebc.BIZCATEGORYID = tep.BIZCATEGORYCODE 
WHERE  tep.PROJNO in (
SELECT DISTINCT regexp_substr('${PROJNO}','[^,]A+',1,level) AS 参数 FROM T_EMC_PROJECT tep 
connect by level <= REGEXP_COUNT('${PROJNO}','[^,]A+')
)
ORDER BY tep.PROJNO]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
<TableData name="点位信息" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="PROJNO"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[WITH project_list AS (
    SELECT DISTINCT regexp_substr('${PROJNO}','[^,]A+',1,level) AS proj_no 
    FROM dual 
    CONNECT BY level <= REGEXP_COUNT('${PROJNO}','[^,]A+')
),
t AS (
	/*送样*/
	SELECT 
	DISTINCT
	tep.PROJNO,
	nvl2(TEOIG.SUBCONTRACTORID,TEOIG.TESTNAME||'*',TEOIG.TESTNAME) AS "检测项目",
	nvl2(teoig.SUBCONTRACTORID,teoig.ITEMGROUP||'*',teoig.ITEMGROUP) AS 分析项组,
	teo.ORDERCATEGORY AS "检测类别",
	teo.id AS monitorpointid,
	teoig.testid,
	teoig.methodid,
	teo.CLIENTORDERNAME AS "检测地点",
	to_char(TEOIG.METHODNAME) AS "检测方法",
	'1' AS "周期",
	'1' AS "频次",
	teo.REMARK AS "备注",
	teoig.ID AS "序号",
	to_char(teo.ID) AS "点位序号",
	to_char(teic.STDNAME) AS 评价标准名称,
	CASE 
		WHEN teis.INDEXLOWLIMIT IS NULL AND teis.INDEXHIGHLIMIT IS NOT NULL THEN '≤'||teis.INDEXHIGHLIMIT
		WHEN teis.INDEXLOWLIMIT IS NOT NULL AND teis.INDEXHIGHLIMIT IS NULL THEN '≥'||teis.INDEXLOWLIMIT
		WHEN teis.INDEXLOWLIMIT IS NOT NULL AND teis.INDEXHIGHLIMIT IS NOT NULL THEN teis.INDEXLOWLIMIT||'~'||teis.INDEXHIGHLIMIT
	END AS 评价标准限值	
	FROM T_EMC_ORDER_ITEM_GROUP teoig 
	LEFT JOIN T_EMC_ORDER teo ON teo.ID = teoig.ORDERID 
	LEFT JOIN T_EMC_PROJECT tep ON tep.ID = teo.PROJID 
	LEFT JOIN t_emc_folder tef ON tef.id=teo.folderid
	LEFT JOIN T_EMC_INDEX_CATEGORY teic ON teic.ID =teoig.INDEXCATEGORYID 
	INNER JOIN project_list pl ON tep.PROJNO = pl.proj_no
	LEFT JOIN (
	select teis.INDEXID,teis.INDEXITEMID,teii.INDEXITEMNAME,teiti.TESTID,teiti.METHODID,teis.INDEXLOWLIMIT,teis.INDEXHIGHLIMIT 
	from T_EMC_INDEX_SET teis 
	LEFT JOIN T_EMC_INDEX_ITEM teii ON teis.INDEXITEMID =teii.ID
	LEFT JOIN T_EMC_INDEX_TEST_ITEM teiti ON teiti.INDEXITEMID =teii.ID
	) teis ON teis.INDEXID =teoig.INDEXID AND teoig.TESTID =teis.TESTID AND teoig.methodid=teis.METHODID	
	WHERE teo.SENDDATE IS NOT NULL
),
bb AS (
	/*送样多因子数量*/
	select 
	teo.ID AS MONITORPOINTID,
	teo.clientordername AS MONITORPOINTNAME,
	teoig.TESTID,
	teoig.methodid,
	count(teoig.ITEMGROUPID) AS num
	from T_EMC_ORDER_ITEM_GROUP teoig 
	LEFT JOIN T_EMC_ORDER teo ON teo.ID =teoig.ORDERID 
	LEFT JOIN T_EMC_PROJECT tep ON tep.ID =teo.PROJID 
	INNER JOIN project_list pl ON tep.PROJNO = pl.proj_no
	WHERE teo.clientordername IS NOT null 
	GROUP BY teo.ID,teo.clientordername,teoig.TESTID,teoig.methodid	
)
SELECT t.*,CASE WHEN bb.num != 1 THEN t.检测项目||'('||bb.num||'项)' ELSE t.分析项组||'('||bb.num||'项)' end AS 检测项目数
FROM t
LEFT JOIN bb ON t.monitorpointid=bb.monitorpointid AND t.testid=bb.testid AND t.methodid=bb.methodid
WHERE 
t.testid NOT IN (1504,260,2788,1983,1984)/*排除烟气参数,干物质*/ 
ORDER BY t.PROJNO,t.点位序号,t.序号 desc]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
<TableData name="有机多因子参数" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="PROJNO"/>
<O></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[WITH bb AS (
	/*送样多因子数量*/
	select 
	teo.ID AS MONITORPOINTID,
	teo.clientordername AS MONITORPOINTNAME,
	teoig.TESTID,
	teoig.methodid,
	count(teoig.ITEMGROUPID) AS num
	from T_EMC_ORDER teo
	LEFT JOIN T_EMC_ORDER_ITEM_GROUP teoig ON teo.ID =teoig.ORDERID 
	LEFT JOIN T_EMC_PROJECT tep ON tep.ID =teo.PROJID 
	WHERE  tep.PROJNO in (
SELECT DISTINCT regexp_substr('${PROJNO}','[^,]A+',1,level) AS 参数 FROM T_EMC_PROJECT tep 
connect by level <= REGEXP_COUNT('${PROJNO}','[^,]A+')
)
	AND teo.clientordername IS NOT null 
	GROUP BY teo.ID,teo.clientordername,teoig.TESTID,teoig.methodid	
)
SELECT 
DISTINCT
tep2.PROJNO,
teoig2.TESTID,teoig2.TESTNAME||'('||bb.num||'项)'  AS TESTNAME,
teoig2.ITEMGROUP
FROM T_EMC_ORDER teo2
LEFT JOIN T_EMC_ORDER_ITEM_GROUP teoig2 ON teoig2.ORDERID =teo2.ID
LEFT JOIN T_EMC_PROJECT tep2 ON tep2.ID =teo2.PROJID 
LEFT JOIN bb ON teoig2.testid=bb.testid AND teoig2.methodid=bb.methodid
WHERE tep2.PROJNO in (
SELECT DISTINCT regexp_substr('${PROJNO}','[^,]A+',1,level) AS 参数 FROM T_EMC_PROJECT tep 
connect by level <= REGEXP_COUNT('${PROJNO}','[^,]A+')
)
AND teoig2.TESTID in
(
select 
teoig.TESTID
FROM T_EMC_PROJECT tep 
LEFT JOIN T_EMC_ORDER teo ON  tep.ID =teo.PROJID 
LEFT JOIN T_EMC_ORDER_ITEM_GROUP teoig ON teoig.ORDERID =teo.ID
WHERE tep.PROJNO in (
SELECT DISTINCT regexp_substr('${PROJNO}','[^,]A+',1,level) AS 参数 FROM T_EMC_PROJECT tep 
connect by level <= REGEXP_COUNT('${PROJNO}','[^,]A+')
)
GROUP BY teoig.orderid,teoig.TESTID
HAVING count(DISTINCT teoig.ITEMGROUPID)/count(DISTINCT teoig.TESTID)>1
)
AND bb.num>1
ORDER BY tep2.PROJNO,teoig2.TESTID]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
