<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.module.item.notification.mapper.CoreNotificationInstanceToMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT R.*,
                       I.TITLE,
                       I.CONTENT,
                       I.VIEWMETHOD,
                       I.MENUID,
                       I.MENUNAME,
                       I.PAGEURL,
                       I.CREATEDTIME,
                       I.PARAM
                  FROM T_CORE_NOTIFICATION_INST I, T_CORE_NOTIFICATION_INST_TO R
                 WHERE R.INSTID = I.ID
                   AND R.NOTIFIEDID = #{loginUser.id}) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>
</mapper>