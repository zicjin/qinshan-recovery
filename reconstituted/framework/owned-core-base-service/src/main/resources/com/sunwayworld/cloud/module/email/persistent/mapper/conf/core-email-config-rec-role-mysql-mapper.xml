<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.cloud.module.email.persistent.mapper.CoreEmailConfigRecRoleMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT R.*,
                       U.ROLENAME 
                  FROM T_CORE_EMAIL_CONFIG_REC_ROLE R, T_CORE_ROLE U
                 WHERE R.ROLEID = U.ID) T 
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
         ORDER BY 
         <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
         </choose>
    </select>
    
    <select id="selectUserListByConfig" parameterType="String" resultType="String">
        SELECT U.USERID
          FROM T_CORE_EMAIL_CONFIG_REC_ROLE CR, T_CORE_ROLE R, T_CORE_ROLE_USER U
         WHERE CR.ROLEID = R.ID
           AND R.ID = U.ROLEID
           AND CR.CONFIGID = #{configId}
    </select>
    
</mapper>