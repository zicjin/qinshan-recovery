<?xml version="1.0" encoding="UTF-8"?>
<WorkBook xmlVersion="20211223" releaseVersion="11.0.0">
<TableDataMap>
<TableData name="ds1" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="kdate"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="edate"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="userid"/>
<O></O>
</Parameter>
<Parameter>
<Attributes name="ANALYSISUSERNAME"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[select
d1.ANALYSISUSERID,
d1.ANALYSISUSERNAME,
d1.ORGNAME,
d1.分析年,
d1.分析月,
d1.ORDERCATEGORY,
d1.METHODNAME,
d1.METHODid,
LISTAGG(distinct d1.TESTNAME,',') as TESTNAME,
count(distinct d1.ORDERID) AS 数量
from 
(select 
ok.ORDERID,
OK.TESTID,
OK.TESTNAME,
ok.METHODid,
OK.METHODNAME,
to_char(u.ORGNAME) AS ORGNAME,
ok.ORDERCATEGORY,
TO_CHAR(r.ANALYSISBEGINDATE,'yyyy') AS 分析年,
TO_CHAR(r.ANALYSISBEGINDATE,'MM') AS 分析月,
ok.ANALYSISDATE,
r.ANALYSISUSERID,
r.ANALYSISUSERNAME,
r.ANALYSISBEGINDATE,
r.ANALYSISENDDATE,
OK.STATUS
from
T_EMC_ORDER_TASK ok
inner join T_EMC_run r  on r.id=ok.runid
inner join t_core_user u on u.id=oK.ANALYSISUSERID
inner join T_EMC_PROJECT tep ON tep.ID =ok.PROJID 
inner join t_core_user tcu ON tcu.PARENTORGID =tep.orgid
where 
OK.ANALYSISTYPE='analysis'
AND tcu.id='${userid}'
and OK.STATUS in('done','audit')
and to_char(r.ANALYSISBEGINDATE,'yyyy-mm-dd') between '${kdate}' and '${edate}'
${if(len(ANALYSISUSERNAME)==0,"","and r.ANALYSISUSERNAME like '%"+ANALYSISUSERNAME+"%'")}
)d1
group by d1.ANALYSISUSERID,d1.ANALYSISUSERNAME,d1.ORGNAME,d1.分析年,d1.分析月,d1.ORDERCATEGORY,d1.methodid,d1.METHODNAME
order by 数量 desc]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
