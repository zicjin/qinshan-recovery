<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.bp.info.infotmpl.mapper.EmcInfoTmplMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT TMPL.*,
                       ORG.ORGNAME        USEDORGNAME,
                       T_CORE_FILE.ID     EXCELID,
                       T_CORE_FILE.NAME   EXCELNAME,
                       ''                 POINT
                  FROM T_EMC_INFO_TMPL TMPL
                  LEFT JOIN T_CORE_ORG ORG
                    ON ORG.ID = TMPL.USEDORGID
                  LEFT JOIN T_CORE_FILE T_CORE_FILE
                    ON T_CORE_FILE.TARGETID = CONCAT('T_EMC_INFO_TMPL$', TMPL.ID)) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>


    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_INFO_TMPL T
         WHERE T.ID = #{id}
    </select>

</mapper>