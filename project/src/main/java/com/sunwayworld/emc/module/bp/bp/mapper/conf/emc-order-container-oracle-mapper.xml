     <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT
                T.*
            FROM
                (
                SELECT
                    O.*,
                    TEO.SAMPLENUM AS ORDERSAMPLENUM,
                    TEO.CYCLE AS ORDERCYCLE ,
                    TEO.FREQUENCY AS ORDERFREQUENCY,
                    TEO.SAMPLEID,
                    A.PROJNO,
                    A.PROJNAME,
                    A.PROJNODE,
                    B.MONITORPOINTNAME,
                    B.MONITORPOINTNO
                FROM
                    T_EMC_ORDER_CONTAINER O
                LEFT JOIN T_EMC_ORDER TEO
                    ON TEO.ID = O.ORDERID
                LEFT JOIN T_EMC_PROJECT A
                    ON O.PROJID = A.ID
                LEFT JOIN T_EMC_FOLDER B
                    ON O.FOLDERID = B.ID
                LEFT JOIN T_EMC_MONITOR_POINT MP
                    ON B.MONITORPOINTID = MP.ID
                LEFT JOIN T_EMC_ORDER_TASK OTK
                    ON O.ID = OTK.ORDERCONTAINERID
                LEFT JOIN T_EMC_ORDER_TASK_RESULT RST
                    ON OTK.ID = RST.ORDERTASKID
                LEFT JOIN T_EMC_SAMPLE SA
                    ON SA.ID = TEO.SAMPLEID
                LEFT JOIN T_EMC_MONITOR_TMPL TMPL
                    ON TMPL.ID = O.MONITORTMPLID
                LEFT JOIN T_EMC_CONTAINER_CATEGORY CC
                    ON CC.ID = O.CONTAINERCATEGORYID
                ) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent"/>
            <if test="searchType == 'sampleIdNull'">
                AND ( T.SAMPLEID IS NULL OR T.SAMPLEID = '')
                AND EXISTS (
                SELECT
                1
                FROM
                T_EMC_ORDER_TASK OT
                WHERE
                OT.ORDERCONTAINERID = T.ID
                AND OT.dataSharing <![CDATA[<>]]> '1'
                )
            </if>
            <if test="searchType == 'sampleIdNotNull'">
                AND T.SAMPLEID IS NOT NULL
            </if>
            <if test="searchType == 'transportIdNull'">
                AND (T.TRANSPORTID IS NULL OR T.TRANSPORTID = '')
            </if>
            <if test="runIdNotNull_filter != null">
                AND EXISTS ( SELECT 1
                FROM T_EMC_ORDER_TASK OT
                WHERE OT.ORDERCONTAINERID = T.ID
                AND OT.RUNID = #{runIdNotNull_filter})
            </if>
            <if test="transportType != null">
                AND EXISTS ( SELECT 1
                FROM T_EMC_ORDER_TASK OT
                WHERE OT.ORDERCONTAINERID = T.ID
                AND OT.ANALYSISTYPE IN ('analysis', 'pretreatment')
                )
            </if>
            <if test="addRunOrderParamIds != null">
                AND EXISTS (SELECT 1
                FROM T_EMC_ORDER_TASK A
                WHERE A.ORDERCONTAINERID = T.ID
                AND (A.RUNID IS NULL OR A.RUNID = '')
                AND A.STATUS = 'logged'
                AND FIND_IN_SET(#{loginUser.id},A.ANALYSISUSERID) > 0
                AND FIND_IN_SET(A.PARAMID,#{addRunOrderParamIds})
                )
            </if>
            <if test="addPretreatmentRunOrderParamIds != null">
                AND EXISTS (SELECT 1
                FROM T_EMC_ORDER_TASK A
                WHERE A.ORDERCONTAINERID = T.ID
                AND (A.PRETREATMENTRUNID IS NULL OR A.PRETREATMENTRUNID = '')
                AND A.STATUS = 'logged'
                AND FIND_IN_SET(#{loginUser.id},A.ANALYSISUSERID) > 0
                AND FIND_IN_SET(A.PARAMID,#{addPretreatmentRunOrderParamIds})
                )
            </if>
            <if test="pretreatmentRunId != null">
                AND EXISTS (SELECT 1
                FROM T_EMC_ORDER_TASK A
                WHERE A.ORDERCONTAINERID = T.ID
                AND (A.PRETREATMENTRUNID = #{pretreatmentRunId})
                AND (A.RUNID IS NULL OR A.RUNID = '')
                AND A.STATUS = 'logged'
                )
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause"/>
            </when>
            <otherwise>
                T.FOLDERID ASC, T.ORDERNO ASC
            </otherwise>
        </choose>
    </select>

    <select id="selectOrderContainerList" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.ID,
                       A.ORDERCONTAINERNO,
                       A.CONTAINERCATEGORYNAME,
                       A.CONTAINERGROUP,
                       A.FIXATIVE,
                       A.ORDERID,
                       A.STORECONDITION,
                       A.DELIVERYID,
                       (CASE WHEN P.SAMPLE = '0' THEN O.SENDDATE ELSE O.SAMPLEBEGINDATE END) AS SAMPLEDATE,
                       P.PROJNO,
                       P.PROJNAME,
                       S.SAMPLENO,
                       S.ORGID AS SAMPLEORGID,
                       S.ACCEPTEDDATE,
                        LISTAGG(DISTINCT A.ISSCAN, ',') AS ISSCAN,
                        LISTAGG(DISTINCT S.ORDERCATEGORY, ',') AS ORDERCATEGORY,
                       LISTAGG(DISTINCT B.TESTNAME, ',') AS TESTNAME,
                       LISTAGG(DISTINCT B.TESTMETHODID, ',') AS MULTITESTID,
                       LISTAGG(DISTINCT C.ITEMGROUP, ',') AS ITEMGROUP
                  FROM T_EMC_ORDER_CONTAINER A
                  LEFT JOIN T_EMC_ORDER_TASK B
                    ON A.ID = B.ORDERCONTAINERID
                  LEFT JOIN T_EMC_ORDER O
                    ON A.ORDERID = O.ID
                  LEFT JOIN T_EMC_SAMPLE S
                    ON O.SAMPLEID = S.ID
                  LEFT JOIN T_EMC_PROJECT P
                    ON O.PROJID = P.ID
                  LEFT JOIN T_EMC_ORDER_ITEM_GROUP C
                    ON A.ORDERID = C.ORDERID AND B.TESTMETHODID = C.TESTMETHODID
        <where>
            <if test="orderId != null">
                A.ORDERID = #{orderId}
            </if>
            <if test="targetType == 'orderAccept'">
                AND A.CONTAINERCATEGORYNAME IS NOT NULL
            </if>
        </where>
        GROUP BY A.ID,
                 A.ORDERID,
                 A.ORDERCONTAINERNO,
                 A.CONTAINERCATEGORYNAME,
                 A.CONTAINERGROUP,
                 A.FIXATIVE,
                 A.STORECONDITION,
                 A.DELIVERYID,
                 P.SAMPLE,
                 O.SENDDATE,
                 O.SAMPLEBEGINDATE,
                 P.PROJNO,
                 P.PROJNAME,
                 S.SAMPLENO,
                 S.ORGID,
                S.ACCEPTEDDATE) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent"/>
            <if test="targetType == 'partHandover' and sampleId != null">
                AND EXISTS (
                SELECT 1 FROM T_EMC_ORDER B LEFT JOIN T_EMC_SAMPLE C ON C.ID = B.SAMPLEID WHERE T.ORDERID = B.ID AND
                C.ID = #{sampleId}
                ) AND T.DELIVERYID IS NULL
            </if>
            <if test="targetType == 'labelScan' and sampleId != null">
                AND EXISTS (
                SELECT 1 FROM T_EMC_ORDER B LEFT JOIN T_EMC_SAMPLE C ON C.ID = B.SAMPLEID WHERE T.ORDERID = B.ID AND
                C.ID = #{sampleId}
                )
            </if>
            <if test="targetType == 'orderReceive'">
                AND EXISTS (
                SELECT
                1
                FROM
                T_EMC_ORDER_TASK OT
                INNER JOIN T_EMC_ORDER O ON OT.ORDERID = O.ID
                WHERE
                OT.ORDERCONTAINERID = T.ID
                AND OT.SAMPLERECEIVERFLAG = '0'
                and OT.STATUS = 'logged'
                and OT.ANALYSISTYPE = 'analysis'
                and O.TERMINATION != '1'
                AND EXISTS (
                SELECT
                1
                FROM
                T_CORE_USER_PERMISSION UP_
                WHERE
                UP_.USERID = #{loginUser.id}
                and UP_.PERMISSIONTYPEID = 'T_CORE_ORG'
                and UP_.TARGETID = OT.ANALYSISORGID)
                )
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause"/>
            </when>
            <otherwise>
                T.ORDERCONTAINERNO ASC
            </otherwise>
        </choose>
    </select>

    <select id="selectOrderReceiveContainerList" parameterType="map" resultType="map">
        SELECT T.*
        FROM (SELECT A.*,
                     (CASE
                          WHEN P.SAMPLE = '0' THEN O.SENDDATE
                          ELSE O.SAMPLEBEGINDATE
                         END) AS SAMPLEDATE,
                     P.PROJNO,
                     P.PROJNAME,
                     P.STATUS,
                     S.SAMPLENO,
                     S.ORGID  AS SAMPLEORGID,
                     OT.TESTNAME
           FROM T_EMC_ORDER_CONTAINER A
           LEFT JOIN T_EMC_ORDER O ON A.ORDERID = O.ID
           LEFT JOIN T_EMC_SAMPLE S ON O.SAMPLEID = S.ID
           LEFT JOIN T_EMC_PROJECT P ON O.PROJID = P.ID
           LEFT JOIN (SELECT B.ORDERCONTAINERID,
                             LISTAGG(DISTINCT B.TESTNAME, ',') AS TESTNAME
                      FROM T_EMC_ORDER_TASK B
                      INNER JOIN T_EMC_PROJECT P ON B.PROJID = P.ID
                      WHERE
                        P.STATUS <![CDATA[<>]]> 'cancel'
                        <if test="targetType == 'orderReceive'">
                        AND B.SAMPLERECEIVERFLAG = '0'
                        AND B.STATUS = 'logged'
                        </if>
                        <if test="targetType == 'orderReceiveSearch'">
                            AND B.SAMPLERECEIVERFLAG = '1'
                            AND P.STATUS <![CDATA[<>]]> 'reportEdit'
                        </if>
                      GROUP BY B.ORDERCONTAINERID) OT ON A.ID = OT.ORDERCONTAINERID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent"/>
                AND T.STATUS <![CDATA[<>]]> 'cancel'
            <if test="targetType == 'orderReceive'">
                AND EXISTS (
                SELECT
                1
                FROM
                T_EMC_ORDER_TASK OT
                INNER JOIN T_EMC_ORDER O ON OT.ORDERID = O.ID
                WHERE
                OT.ORDERCONTAINERID = T.ID
                AND OT.SAMPLERECEIVERFLAG = '0'
                and OT.STATUS = 'logged'
                and OT.ANALYSISTYPE = 'analysis'
                and O.TERMINATION != '1'
                AND EXISTS (
                SELECT
                1
                FROM
                T_CORE_USER_PERMISSION UP_
                WHERE
                UP_.USERID = #{loginUser.id}
                and UP_.PERMISSIONTYPEID = 'T_CORE_ORG'
                and UP_.TARGETID = OT.ANALYSISORGID)
                )
            </if>
            <if test="targetType == 'orderReceiveSearch'">
                AND T.STATUS <![CDATA[<>]]> 'reportEdit'
                AND EXISTS (
                SELECT
                1
                FROM
                T_EMC_ORDER_TASK OT
                INNER JOIN T_EMC_ORDER O ON OT.ORDERID = O.ID
                WHERE
                OT.ORDERCONTAINERID = T.ID
                AND OT.SAMPLERECEIVERFLAG = '1'
                and OT.ANALYSISTYPE = 'analysis'
                and O.TERMINATION != '1'
                AND EXISTS (
                SELECT
                1
                FROM
                T_CORE_USER_PERMISSION UP_
                WHERE
                UP_.USERID = #{loginUser.id}
                and UP_.PERMISSIONTYPEID = 'T_CORE_ORG'
                and UP_.TARGETID = OT.ANALYSISORGID)
                )
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause"/>
            </when>
            <otherwise>
                T.PROJNO desc,T.SAMPLENO DESC,T.ORDERCONTAINERNO ASC
            </otherwise>
        </choose>
    </select>

</mapper>
