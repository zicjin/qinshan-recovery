<TableDataMap>
<TableData name="地表水检测结果表" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="projNo"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[select 
tef.MONITORPOINTNAME AS 点位名称,
teo.ORDERNO AS 样品编号,
-- nvl2(teo.SENDDATE,teo.SENDDATE,teo.SAMPLEBEGINDATE) AS 样品日期,
teot.TESTNAME AS 检测因子,
teig.itemgroup AS 分析项组,
teotr.itemname AS 分析项,
teotr.unitname AS 单位,
max(case 
when teotr.AVGRESULT is null then decode(teotr.REPORTRESULT,'ND',concat('＜',teotr.LOWLIMIT),STRINGTOSCIENCE(teotr.REPORTRESULT))
else decode(teotr.AVGRESULT,'ND',concat('＜',teotr.LOWLIMIT),STRINGTOSCIENCE(teotr.AVGRESULT))
END) as 检测结果
FROM T_EMC_PROJECT tep
LEFT JOIN T_EMC_FOLDER tef ON tef.projid = tep.id
LEFT JOIN T_EMC_ORDER teo ON teo.folderid=tef.id
LEFT JOIN T_EMC_ORDER_TASK teot ON teo.id =teot.orderID 
LEFT JOIN T_EMC_ORDER_TASK_RESULT teotr ON teot.id = teotr.ordertaskid
-- LEFT JOIN t_emc_order_item_group teoig ON teotr.orderid = teoig.orderid AND teoig.testmethodid = teotr.testmethodid
LEFT JOIN t_emc_item tei ON teotr.itemid = tei.id 
LEFT JOIN t_emc_group_item tegi ON tegi.itemid = tei.id
inner JOIN t_emc_item_group teig ON tegi.itemgroupid = teig.id AND teig.testmethodid = tei.testmethodid
WHERE teo.QCCATEGORYCODE in ('N/A','P-BLANK','Q-DUP','P-DUP','PQC-STD','zcsbkb','P-YSKB')
AND teotr.REPORTDISPLAY =1
AND tep.PROJNO ='${projNo}'
AND teot.STATUS in ('audit','done')
GROUP BY tef.MONITORPOINTNAME,teo.ORDERNO,teot.TESTNAME,teig.itemgroup,teotr.itemname,teotr.unitname
ORDER BY tef.MONITORPOINTNAME]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
