<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.cloud.module.train.exam.persistent.mapper.CoreExamMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT R.*,
                       P.TMPLNAME,
                       P.TOTALSCORE,
                       (R.SINGLECHOICEQTY || '/' || R.TMPLSINGLECHOICEQTY) SINGLECHOICEQTYRATE,
                       (R.MULTIPLECHOICEQTY || '/' || R.TMPLMULTIPLECHOICEQTY) MULTIPLECHOICEQTYRATE,
                       (R.COMPLETIONQTY || '/' || R.TMPLCOMPLETIONQTY) COMPLETIONQTYRATE,
                       (R.JUDGEMENTQTY || '/' || R.TMPLJUDGEMENTQTY) JUDGEMENTQTYRATE,
                       (R.SHORTANSWERQTY || '/' || R.TMPLSHORTANSWERQTY) SHORTANSWERQTYRATE 
                  FROM T_CORE_EXAM R
                  LEFT JOIN T_CORE_EXAM_TMPL P
                    ON R.EXAMTMPLID = P.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test='authority_audit == "1"'>
                AND <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.auditAuthorityWhereClause" />
            </if>
        </where>
        ORDER BY 
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID
            </otherwise>
        </choose>
    </select>
</mapper>