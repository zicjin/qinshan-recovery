<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.bizmdm.monitortmpl.mapper.EmcMonitorTmplMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.* 
          FROM (SELECT A.*, 
                       B.MONITORTMPLGROUP
                  FROM T_EMC_MONITOR_TMPL A
                  LEFT JOIN T_EMC_MONITOR_TMPL_GROUP B
                    ON A.MONITORTMPLGROUPID = B.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test="target_unassigned != null">
                AND NOT EXISTS (SELECT 1
                                  FROM ${targetTable} TAR_
                                 WHERE TAR_.${targetMonitorTmplIdColumn} = T.ID
                                 <if test="targetFilterColumn != null">
                                     AND TAR_.${targetFilterColumn} = #{targetFilterValue}
                                 </if>
                                 <if test="targetFilterColumn1 != null">
                                     AND TAR_.${targetFilterColumn1} = #{targetFilterValue1}
                                 </if>
                                ) 
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ORDERNO ASC,T.ID DESC
            </otherwise>
        </choose>
    </select>
    
    
    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.String" resultType="map">
        SELECT T.*, 
               B.MONITORTMPLGROUP
          FROM T_EMC_MONITOR_TMPL T
          LEFT JOIN T_EMC_MONITOR_TMPL_GROUP B
            ON T.MONITORTMPLGROUPID = B.ID
         WHERE T.ID = #{id}
    </select>
    
</mapper>