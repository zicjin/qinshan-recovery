<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.module.admin.tenant.mapper.CoreAdminTenantUserMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       U.USERNAME
                  FROM T_CORE_ADMIN_TENANT_USER A
                  LEFT JOIN T_CORE_USER U
                    ON A.USERID = U.ID) T
         <where>
             <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
         </where>
         ORDER BY T.ID ASC
    </select>
</mapper>