<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[select   
tep.PROJNO 项目编号,   
tep.PROJNAME 项目名称, 
tep.ENTRUSTORGNAME 委托单位,     
tep.TESTORGNAME 受检单位,   
tef.REMARK 点位备注, 
teo.ORDERNO 样品编号,   
teo.QCNAME 样品类型,  
case 
	WHEN teo.CLIENTORDERNAME is null 
	then concat(tef.MONITORPOINTNO,tef.MONITORPOINTNAME)
	else teo.CLIENTORDERNAME 
end as 样品标识,
CASE WHEN TEP.SAMPLE=1
	THEN to_char(teo.SAMPLEBEGINDATE,'YYYY-MM-DD')
	ELSE to_char(teo.SENDDATE,'YYYY-MM-DD')
END as 样品日期,
tei.ITEMALIASNAME 检测项别名,   
teotr.ITEMORDERNO 排序码,
tet.TESTNAME 检测项,   
nvl(teotr.LOWLIMIT,'/') 检出限,   
case 
when teotr.AVGRESULT is null then decode(teotr.REPORTRESULT,'ND',concat('＜',teotr.LOWLIMIT),STRINGTOSCIENCE(teotr.REPORTRESULT))
else decode(teotr.AVGRESULT,'ND',concat('＜',teotr.LOWLIMIT),STRINGTOSCIENCE(teotr.AVGRESULT))
end as 报出结果,
teotr.UNITNAME 单位, 
teot.STATUS as 分析进度,  
ter.ANALYSISUSERNAME 分析员,
tep.PROJNODE AS 任务状态
from  t_emc_order_task_result teotr   
inner join t_emc_project tep on tep.ID = teotr.PROJID   
inner join t_emc_folder tef on tef.ID =teotr.FOLDERID   
inner join t_emc_order_task teot on teot.ID =teotr.ORDERTASKID  
inner join t_emc_order teo on teo.ID = teot.ORDERID   
left join t_emc_run ter on ter.id =teotr.runid   
inner join t_emc_test tet on tet.ID =teotr.TESTID 
inner join t_emc_item tei on tei.ID =teotr.ITEMID
--LEFT JOIN t_core_user tcu ON TCU.PARENTORGID =tep.orgid
where 
1=1
-- and tcu.id='${userid}'
--AND tep.PROJNODE in('分析中','报告编制','采样中','样品接收')
${if(len(testname) == 0,"","and tep.TESTORGNAME like '%" + testname + "%'")}   
${if(len(projno) == 0,"","and tep.PROJNO = '" + projno + "'")}
${if(urgent,"and tep.urgent ='1'","")} 
${if(iscy==1,"and to_char(teo.SAMPLEBEGINDATE,'YYYY-MM-DD') between '"+senddate+"' and '"+senddate2+"'","and to_char(teo.senddate,'YYYY-MM-DD') between '"+senddate+"' and '"+senddate2+"'")}
and teo.QCCATEGORYCODE ='N/A'  
and teotr.REPORTDISPLAY = 1 
and tei.REPORTDISPLAY =1
AND tef.TERMINATION=0 --不显示终止的
order by teo.ORDERNO,teot.testid,teotr.ITEMORDERNO]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
