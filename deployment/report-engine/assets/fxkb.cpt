<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT 
	tt.任务编号,tt.任务名称,tt.样品类型,tt.点位样品名称,tt.采送样日期,tt.检测因子分类,tt.方法,
	listagg(DISTINCT 检测因子,',') AS 检测因子,
	tt.分析员 AS 分析员,
	tt.工作日数量,
	CASE WHEN tt.任务编号 LIKE '%HS%' AND tt.工作日数量>=3 AND tt.工作日数量<4 THEN '预警数据'
	WHEN tt.任务编号 LIKE '%HS%' AND tt.工作日数量>=4 THEN '超期数据'
	WHEN tt.任务编号 LIKE '%TS%' AND tt.工作日数量>=5 AND tt.工作日数量<6 THEN '预警数据'
	WHEN tt.任务编号 LIKE '%TS%' AND tt.工作日数量>=6 THEN '超期数据' ELSE '正常数据' END AS 时效性,
	COUNT(DISTINCT tt.样品容器id) AS 样品数量,
	COUNT(DISTINCT CASE WHEN tt.因子状态 IN('approve','audit','done') THEN tt.样品容器id ELSE null end) AS 完成数量,
	COUNT(DISTINCT CASE WHEN tt.因子状态 IN('draft','prelogged') THEN tt.样品容器id ELSE null end) AS 未分析,
	COUNT(DISTINCT CASE WHEN tt.因子状态 IN('logged') THEN tt.样品容器id ELSE null end) AS 分析中
FROM 
(
	select 
	tep.PROJNO AS 任务编号,
	tep.PROJNAME AS 任务名称,
	teo.ORDERCATEGORY AS 样品类型,
	nvl2(tef.MONITORPOINTNAME,tef.MONITORPOINTNAME,teo.CLIENTORDERNAME) AS 点位样品名称,
	to_char(nvl2(teo.SENDDATE,teo.SENDDATE,teo.SAMPLEBEGINDATE),'YYYY-MM-DD') AS 采送样日期,
	decode(tetm.TESTMETHODTYPE,'inorganic','无机','chemical','理化','organic','有机') AS 检测因子分类,
	CASE WHEN teot.ORDERCONTAINERID IS NULL THEN 1428608141171456 ELSE teot.ORDERCONTAINERID END AS 样品容器id, /*送样无容器信息的置为999的那个容器*/
	teot.methodname AS 方法,
	teot.TESTNAME AS 检测因子,
	teot.INPUTUSERNAME AS 分析员,
	teot.status AS 因子状态,
	tes.ACCEPTEDDATE AS 接样日期,
	SYSDATE AS 当前系统日期,
	ter.ANALYSISENDDATE AS 分析完成日期,
	WORKDAYS_BETWEEN(tes.ACCEPTEDDATE,nvl(ter.ANALYSISENDDATE,SYSDATE)) AS 工作日数量
	from T_EMC_ORDER_TASK teot 
	LEFT JOIN T_EMC_TEST_METHOD tetm ON tetm.ID =teot.TESTMETHODID
	LEFT JOIN T_EMC_ORDER teo ON teo.ID =teot.ORDERID 
	LEFT JOIN T_EMC_FOLDER tef ON tef.ID =teo.FOLDERID 
	LEFT JOIN T_EMC_PROJECT tep ON tep.ID =tef.PROJID 
	LEFT JOIN T_EMC_SAMPLE tes ON tes.ID = teo.SAMPLEID 
	LEFT JOIN T_EMC_RUN ter ON ter.ID = teot.RUNID 
	WHERE 
	tep.STATUS <> 'cancel'
	AND tep.projnode NOT LIKE '报告%'
	AND teot.STATUS IN ('prelogged','logged','approve','audit','done')
	AND ANALYSISTYPE='analysis'
	--AND tep.projno='CQTS240775' /*用于调试数据*/
	${if(len(projNo)==0,"","and tep.projno like '%"+projNo+"%'")}
	${if(len(projName)==0,"","and tep.projname like '%"+projName+"%'")}
	${if(len(methodName)==0,"","and teot.methodName like '%"+methodName+"%'")}
	and to_char(nvl2(teo.SENDDATE,teo.SENDDATE,teo.SAMPLEBEGINDATE),'YYYY-MM-DD') between '${bgdate}' and '${enddate}'
	${if(len(testName)==0,"","and teot.testname like '%"+testName+"%'")}
	${if(len(orderCategory)==0,"","and teo.ordercategory like '%"+orderCategory+"%'")}
	${if(len(yzzb)==0,"","and tetm.TESTMETHODTYPE = '"+yzzb+"'")}
	${if(len(methodName)==0,"","and teot.methodName like '%"+methodName+"%'")}
	${if(isDg,"and (tep.sample=0 or tep.projname like '单轨%')","")}
) tt
GROUP BY tt.任务编号,tt.任务名称,tt.样品类型,tt.点位样品名称,tt.采送样日期,tt.检测因子分类,tt.方法,tt.分析员,tt.工作日数量]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
