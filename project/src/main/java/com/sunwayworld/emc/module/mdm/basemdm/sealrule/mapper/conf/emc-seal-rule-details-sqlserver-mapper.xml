<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.basemdm.sealrule.mapper.EmcSealRuleDetailsMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
        FROM ( SELECT A.*,
                       S.NAME,
                       S.FIELD,
                       S.BUSINESSCATEGORY,
                       S.LABORATORY,
                       S.ACTIVEDFLAG,
                       F.ID AS FILEID,
                       F.NAME AS FILENAME
                 FROM T_EMC_SEAL_RULE_DETAILS A
            LEFT JOIN T_EMC_SEAL_RULE S ON A.SEALRULEID = S.ID
            LEFT JOIN T_CORE_FILE F ON F.TARGETID = CONCAT('T_EMC_SEAL_RULE_DETAILS$', A.ID)
             ) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>

</mapper>