# Copy through an approved restricted channel to private/t06-production-readonly.env,
# fill the values, and chmod 600. Do not commit the filled file.
PRODUCTION_READ_ONLY=1
DB_ACCOUNT_PURPOSE=t06_attachment_inventory_select_only
JDBC_URL=jdbc:oracle:thin:@//<approved-host>:<port>/<service>
DB_USER=<dedicated-select-only-user>
DB_PASSWORD=<dedicated-select-only-password>
JDBC_DRIVER_CLASS=oracle.jdbc.OracleDriver
JDBC_DRIVER_SHA256=<sha256-of-tools-db-probe-lib-ojdbc8-19.3.0.0.jar>
SCHEMA=<APP_SCHEMA>
CONSISTENCY_MODE=flashback-scn
CONSISTENCY_REFERENCE=<DBA-approved-SCN-or-storage-snapshot-reference>
FLASHBACK_SCN=<numeric-approved-SCN>
