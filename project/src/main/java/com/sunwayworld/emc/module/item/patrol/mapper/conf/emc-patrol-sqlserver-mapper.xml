<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.item.patrol.mapper.EmcPatrolMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
        FROM T_EMC_PATROL T
        <where>
            <include
                refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test="_parameter.containsKey('patrolUserIdExact')">
                <choose>
                    <when test="patrolUserIdExact != null and patrolUserIdExact != ''">
                        AND CONVERT(NVARCHAR(MAX), T.PATROLUSERID) = #{patrolUserIdExact}
                    </when>
                    <otherwise>
                        AND 1 = 2
                    </otherwise>
                </choose>
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include
                    refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID ASC
            </otherwise>
        </choose>
    </select>


    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long"
        resultType="map">
        SELECT T.*
        FROM T_EMC_PATROL T
        WHERE T.ID = #{id}
    </select>

</mapper>
