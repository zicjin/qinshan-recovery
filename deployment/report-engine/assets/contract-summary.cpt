<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[WITH tep as(
SELECT * FROM (
	SELECT
		ROW_NUMBER() OVER (PARTITION BY contractid ORDER BY tep.projno) AS rn,
		tep.contractid,
		tep.CONTRACTNO AS 合同号,
		bc.BIZCATEGORYNAME as 检测类型,
		tep.PROJNO AS 任务编号,
		tep.PROJNAME AS 任务名称,
		tep.ENTRUSTORGNAME AS 委托单位,
		tep.TESTORGNAME AS 受检单位,
		tep.TESTPROJECTNAME AS 项目名称,
		tep.TESTORGADDRESS AS 受检单位地址,
		CASE WHEN tep.testprojects IS NOT NULL THEN tep.testprojects
		ELSE teot.ORDERCATEGORY||'：'||LISTAGG(DISTINCT teot.testname,',')||'\n' 
		END AS 检测项目
	FROM
		t_emc_project tep
	LEFT JOIN T_EMC_BIZ_CATEGORY bc ON tep.BIZCATEGORYID =bc.id
	LEFT JOIN t_emc_order_task teot ON teot.projid=tep.id
	WHERE tep.status <> 'cancel'
	GROUP BY tep.CONTRACTID,tep.CONTRACTNO,bc.BIZCATEGORYNAME,tep.PROJNO,tep.PROJNAME,tep.ENTRUSTORGNAME,tep.TESTORGNAME,tep.TESTPROJECTNAME,tep.TESTORGADDRESS,teot.ORDERCATEGORY,tep.testprojects
) t WHERE t.rn=1
),
contract AS (
	select 
		tcc.id,
		TO_CHAR(tcc.CREATEDTIME,'YYYY-MM') AS 月份,
		tcc.CONTRACTNO AS 合同号,
		tcc.clientname as 客户名称,
		tcc.PROJECTNAME as 项目名称,
		tcc.SIGNDATE AS 合同签订日期,
		tcc.CLIENTCONTACT AS 客户联系人,
		tcc.CLIENTLEGALPHONE AS 客户联系人电话,
		tcc.AGENT as 代理人,
		tcc.AGENTPHONE as 代理人联系电话,
		tcc.CONTRACTORGNAME,
		tcc.CONTRACTPRICE AS 合同金额,
		to_char(tcc.CREATEDTIME,'YYYY-MM-DD') AS 合同创建日期,
		tcc.RETURNDATE AS 合同返回日期,
		tcc.CONTRACTSTATUSTWO AS 合同状态,
		tcc.BUSINESSAREA AS 所属区域,
		tcc.BIZORGNAME as 业务所属部门,
		tcc.projectPlace as 项目地址,
		tcc.CONTRACTCONTENT as 项目付款条件,
		REGEXP_SUBSTR(tcc.projectPlace, '[^/]A+', 1, 1) AS 省,
		REGEXP_SUBSTR(tcc.projectPlace, '[^/]A+', 1, 2) AS 市,
		REGEXP_SUBSTR(tcc.projectPlace, '[^/]A+', 1, 3) AS 区,
		tcc.SIGNUSERNAME AS 签约人,
		tcc.ASSISTANT AS 业务助理,
		tcc.PREMIUMDISCOUNT AS 预计折扣,
		tcc.CUSTOMERSOURCE as 客户来源,
		tcc.EMAIL AS 邮箱,
		tcc.CONTRACTCLASSIFICATION AS 业务分类,
		tcc.remark AS 备注
	from 
	t_crm_contract tcc
),
contractfb AS (
	select 
		tcpc.CONTRACTID,
		LISTAGG(tcpc.PACKINFO||':'||tcpc.AMOUNT||'\n',',') AS 预登记分包,
		LISTAGG(tcpc.PACKINFO||':'||tcpc.REALAMOUNT||'\n',',')  AS 实际记分包
	from T_CRM_CONTRACT_PACKPRICE tcpc
	GROUP BY tcpc.CONTRACTID
)
SELECT 
contract.*,
tep.*,
contractfb.*
FROM contract
LEFT JOIN tep ON contract.合同号=tep.合同号 
LEFT JOIN contractfb ON contract.id=contractfb.contractid 
WHERE 
contract.CONTRACTORGNAME='青山绿水（江苏）检验检测有限公司'
and to_date(contract.合同创建日期,'yyyy-mm-dd') BETWEEN to_date('${begindate}','yyyy-mm-dd') and to_date('${enddate}','yyyy-mm-dd')
${if(len(contractno)==0,"","and lower(contract.合同号) like '%"+lower(contractno)+"%'")}
${if(len(BUSINESSUSERNAME)==0,"","and contract.签约人 like '%"+BUSINESSUSERNAME+"%'")}
ORDER BY contract.月份]]></Query>
