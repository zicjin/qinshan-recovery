</Connection>
<Query>
<![CDATA[SELECT * FROM 
(
SELECT
        tep.PROJNO AS 项目编号,
        tep.PROJNAME AS 项目名称,
        NVL2(tep.COMPLEDATE,to_char(tep.COMPLEDATE,'yyyy-mm-dd'),tep.period) AS 完成期限,
        CASE WHEN tep.period = '7~15' THEN '15' ELSE tep.period END AS period,
        to_char(teo.ACCEPTEDDATE,'yyyy-mm-dd') AS 样品接收日期,
        to_char(teo.ACCEPTEDDATE+7,'yyyy-mm-dd') AS 要求7天完成日期,
        ter.REPORTNO AS 报告编号,
        to_char(tep.toreporteditdate,'yyyy-mm-dd') AS 至报告编制时间,
        DECODE(ter.STATUS,'draft','报告编制','reportAudit','报告审核','reportIssue','报告签发','reportPrint','报告打印','reportSend','报告发送','reportSeal','报告发送','reportArchiving','报告归档') AS 报告阶段,
        ter.CREATEDBYNAME AS 报告编制人,
        to_char(ter.CREATEDTIME,'yyyy-mm-dd') AS 报告编制时间,
        tep.REPORTREVIEWERNAME AS 报告审核人,
        T.createdtime AS 报告审核日期,
        tep.REPORTISSUEUSERNAME AS 报告签发人,
        to_char(tep.REPORTISSUETIME,'yyyy-mm-dd') AS 报告签发日期,
            CASE  WHEN tep.REPORTISSUETIME IS NULL and teo.ACCEPTEDDATE IS NULL THEN '' else 
      to_char (trunc(tep.REPORTISSUETIME - teo.ACCEPTEDDATE ))  END zhi , 
      CASE  WHEN tep.REPORTISSUETIME IS NULL and teo.ACCEPTEDDATE IS NOT NULL THEN 
      to_char (trunc(SYSDATE - teo.ACCEPTEDDATE ))  END zhi1 ,
       CASE  WHEN tep.COMPLEDATE IS NOT NULL AND tep.REPORTISSUETIME IS NOT NULL  THEN 
      to_char (trunc(tep.REPORTISSUETIME - tep.COMPLEDATE ))  END zhi2 ,
        CASE WHEN 
        		   (CASE WHEN tep.REPORTISSUETIME IS NOT NULL and teo.ACCEPTEDDATE IS NOT NULL AND tep.COMPLEDATE IS NULL THEN to_char(trunc(tep.REPORTISSUETIME - teo.ACCEPTEDDATE)) END) > (CASE WHEN tep.period = '7~15' THEN '15' ELSE NVL(tep.period,'10') END) 
               OR (CASE WHEN tep.COMPLEDATE IS NOT NULL AND tep.REPORTISSUETIME IS NOT NULL THEN to_char(trunc(tep.REPORTISSUETIME - tep.COMPLEDATE)) END) > 0 
               OR (CASE WHEN tep.REPORTISSUETIME IS NULL AND teo.ACCEPTEDDATE IS NOT NULL AND tep.COMPLEDATE IS NULL THEN to_char(trunc(SYSDATE - teo.ACCEPTEDDATE )) END) > (CASE WHEN tep.period = '7~15' THEN '15' ELSE NVL(tep.period,'10') END)
               OR (CASE WHEN tep.COMPLEDATE IS NOT NULL AND tep.REPORTISSUETIME IS NULL THEN to_char(trunc(SYSDATE - tep.COMPLEDATE)) END) > 0 
               THEN '超期'
             WHEN (CASE WHEN tep.REPORTISSUETIME IS NOT NULL and teo.ACCEPTEDDATE IS NOT NULL and tep.COMPLEDATE IS NULL then trunc(tep.REPORTISSUETIME - teo.ACCEPTEDDATE) END)+1 - to_number((CASE WHEN tep.period = '7~15' THEN 15 WHEN REGEXP_LIKE(NVL(tep.period,'10'), '^-?[0-9]A+\.?[0-9]A*$') THEN TO_NUMBER(NVL(tep.period,'10')) ELSE 10 END)) >0
               OR (CASE WHEN tep.COMPLEDATE IS NOT NULL AND tep.REPORTISSUETIME IS NOT NULL  THEN to_char(trunc(tep.REPORTISSUETIME - tep.COMPLEDATE))  END) > -1 
               OR (CASE WHEN tep.REPORTISSUETIME IS NULL and teo.ACCEPTEDDATE IS NOT NULL and tep.COMPLEDATE IS  NULL THEN to_char(trunc(SYSDATE - teo.ACCEPTEDDATE)) END) -(CASE WHEN tep.period = '7~15' THEN '15' ELSE NVL(tep.period,'10') END) >-1 
               OR (CASE WHEN tep.COMPLEDATE IS NOT NULL AND tep.REPORTISSUETIME IS  NULL THEN to_char(trunc(SYSDATE - tep.COMPLEDATE))  END) > -1  
               THEN '预警'
               ELSE '准时'
        END AS 超期预警
FROM  T_EMC_PROJECT tep 
LEFT JOIN (SELECT * FROM T_EMC_REPORT WHERE PROCESSSTATUS <> 'draft') ter ON ter.PROJID =tep.ID
LEFT JOIN (SELECT PROJID,max(ACCEPTEDDATE) AS ACCEPTEDDATE FROM T_EMC_ORDER GROUP BY PROJID) teo ON tep.ID =teo.PROJID 
LEFT JOIN t_core_user tcu ON TCU.PARENTORGID =tep.orgid
LEFT JOIN t_core_bpmn_comment tcbc ON tcbc.targetid = 'T_EMC_REPORT$' || ter.id and tcbc.TASKNAME = '报告审核'
and tcbc.STATUS = 'APPROVE' 
left join (
select ID,TARGETID ,CREATEDTIME from t_core_bpmn_comment tcbc3 where not exists (
select 1 from t_core_bpmn_comment tcbc4 where tcbc3.TARGETID = tcbc4.TARGETID and tcbc4.ID > tcbc3.ID
 and STATUS = 'APPROVE' and STATUSCODE = 'reportAudit')
) T on T.ID = tcbc.ID
WHERE tcu.id='${userid}' 
AND tep.STATUS <>'cancel'
AND tep.PROJNODE IN('报告编制','报告审核','报告签发','报告打印','报告归档','报告发送')
--AND ter.PROCESSSTATUS <> 'draft'
AND to_char(teo.ACCEPTEDDATE,'yyyy-mm-dd') BETWEEN '${bgdate}' AND '${enddate}'
${if(len(projNo)==0,"","and tep.projNo like '%"+projNo+"%'")}
${if(len(projName)==0,"","and tep.projname like '%"+projName+"%'")}
ORDER BY teo.ACCEPTEDDATE DESC
) t 
where 1=1
${if(cqyj='全部',"","and t.超期预警='"+cqyj+"'")}]]></Query>
