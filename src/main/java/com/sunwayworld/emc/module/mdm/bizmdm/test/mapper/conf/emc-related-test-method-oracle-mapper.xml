<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.bizmdm.test.mapper.EmcRelatedTestMethodMapper">

    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       B.TESTCATEGORYID,
                       B.TESTID,
                       C.METHODNAME,
                       C.TESTMETHODBASIS,
                       C.METHODNO,
                       D.TESTNAME
                  FROM T_EMC_RELATED_TEST_METHOD A
                  LEFT JOIN T_EMC_TEST_METHOD B
                    ON A.RELATEDTESTMETHODID = B.ID
                  LEFT JOIN T_EMC_METHOD C
                    ON B.METHODID = C.ID
                  LEFT JOIN T_EMC_TEST D
                    ON B.TESTID = D.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>

    <select id="selectDetail" parameterType="java.lang.String" resultType="map">
        SELECT T.*
        FROM T_EMC_RELATED_TEST_METHOD T
        WHERE T.ID = #{id}
    </select>
</mapper>
