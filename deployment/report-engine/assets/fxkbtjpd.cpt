</Connection>
<Query>
<![CDATA[SELECT 
    tt.检测因子 AS 检测因子,
	检测方法,
	tt.分析人员 AS 分析人员,
	listagg(DISTINCT 样品编号,',') AS 样品编号,
	listagg(DISTINCT 任务编号,''',''') AS 任务编号,
	tt.接样日期 AS 接样日期,
	listagg(DISTINCT 因子状态,',') AS 因子状态,
	COUNT(tt.样品编号) AS 样品数量,
	COUNT(CASE WHEN tt.因子状态 IN('approve','audit','done') THEN 1 ELSE null end) AS 完成数量,
	CASE WHEN COUNT(tt.样品编号) = COUNT(CASE WHEN tt.因子状态 IN('approve','audit','done') THEN 1 ELSE null end) THEN 1 ELSE 0 END AS 是否完成
FROM 
(
	SELECT
	DISTINCT 
	decode(tetm.TESTMETHODTYPE,'inorganic','无机','chemical','理化','organic','有机') AS 检测因子分类,
	teot.TESTNAME AS 检测因子,
	teot.METHODNAME AS 检测方法,
	teot.inputusername AS 分析人员,
	teo.ORDERNO AS 样品编号,
	tep.PROJNO AS 任务编号,
	teot.status AS 因子状态,
	to_char(teo.ACCEPTEDDATE,'yyyy-mm-dd') AS 接样日期
	from T_EMC_ORDER_TASK teot 
	LEFT JOIN T_EMC_TEST_METHOD tetm ON tetm.ID =teot.TESTMETHODID
	LEFT JOIN T_EMC_ORDER teo ON teo.ID =teot.ORDERID 
	LEFT JOIN T_EMC_FOLDER tef ON tef.ID =teo.FOLDERID 
	LEFT JOIN T_EMC_PROJECT tep ON tep.ID =tef.PROJID 
	WHERE 
	tep.STATUS <> 'cancel'
	AND teot.STATUS IN ('prelogged','logged','approve','audit','done')
	AND ANALYSISTYPE='analysis'
     ${if(len(yzFl)==0,"","AND tetm.TESTMETHODTYPE ='"+yzFl+"'")}
-- and to_char(nvl2(teo.SENDDATE,teo.SENDDATE,teo.SAMPLEBEGINDATE),'YYYY-MM-DD') between '${bgdate}' and '${enddate}'
	AND to_char(teo.ACCEPTEDDATE,'YYYY-MM-DD') between '${bgdate}' and '${enddate}'
	--AND teo.ACCEPTEDDATE IS NOT null
	${if(len(methodName)==0,"","AND teot.METHODNAME LIKE '%"+methodName+"%'")}
	${if(len(analysName)==0,"","AND teot.inputusername LIKE '%"+analysName+"%'")}
) tt
GROUP BY tt.检测因子,检测方法,tt.分析人员,tt.接样日期
ORDER BY tt.接样日期 DESC ,tt.检测因子]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
