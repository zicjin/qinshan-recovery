<TableData name="样品类型" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="PROJNO"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>${OWNED_REPORT_DATASOURCE_NAME}</DatabaseName>
</Connection>
<Query>
<![CDATA[select 
DISTINCT temt.MONITORTMPLNAME AS 样品类型
from T_EMC_PROJ_SCHEME teps 
LEFT JOIN T_EMC_PROJECT tep ON tep.ID = teps.PROJID 
LEFT JOIN T_EMC_MONITOR_TMPL temt ON temt.ID = teps.MONITORTMPLID
WHERE tep.PROJNO =(
SELECT DISTINCT regexp_substr('${PROJNO}','[^,]A+',1,level) AS 参数 FROM T_EMC_PROJECT tep 
connect by level <= REGEXP_COUNT('${PROJNO}','[^,]A+')
)]]></Query>
