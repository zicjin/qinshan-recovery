<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.basemdm.subcontractor.mapper.EmcSubcontractRecordMapper">
    
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       C.ORDERNO,
                       B.TESTNAME,
                       B.TESTID,
                       B.METHODNAME,
                       B.ANALYSISORGNAME
                  FROM T_EMC_SUBCONTRACT_RECORD A
                  LEFT JOIN T_EMC_ORDER_TASK B 
                    ON A.ORDERTASKID = B.ID
                  LEFT JOIN T_EMC_ORDER C
                    ON B.ORDERID = C.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY 
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>
    
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT *
          FROM T_EMC_SUBCONTRACT_RECORD
         WHERE A.ID = #{id}
    </select>
    
    
    
</mapper>