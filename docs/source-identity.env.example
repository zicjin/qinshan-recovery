# Restricted source-package identity for a sanitized handoff tree without .git.
# Copy through an approved channel to private/source-identity.env, fill with
# SHA-256 values of the approved root and nested project source packages, and
# chmod 600. Do not use this file to authorize the current unclean worktree.
ROOT_SOURCE_ID=sha256:<64-lowercase-hex>
PROJECT_SOURCE_ID=sha256:<64-lowercase-hex>
