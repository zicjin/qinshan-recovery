<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.bizmdm.stdsetcategory.mapper.EmcStdSetCategoryMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM T_EMC_STD_SET_CATEGORY T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
         ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>

    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_STD_SET_CATEGORY T
         WHERE T.ID = #{id}
    </select>
    
    <select id="selectFieldInfoPagination" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT TABLE_NAME AS TABLENAME,
                       COLUMN_NAME AS FIELDNAME,
                       COLUMN_COMMENT AS FIELDTITLE,
                       UPPER(ORDINAL_POSITION) AS ORDER_ID
                  FROM INFORMATION_SCHEMA.COLUMNS A
                 WHERE NOT EXISTS (SELECT 1
                          FROM T_EMC_FIELD_SET B
                         WHERE STANDARDSETID = #{standardSetId}
                           AND A.COLUMN_NAME = B.FIELDNAME)
                 GROUP BY TABLE_NAME, COLUMN_NAME) T
         <where>
             <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
         </where>
          ORDER BY
         <choose>
           <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
           </when>
           <otherwise>
                T.ORDER_ID
           </otherwise>
        </choose>
    </select>
</mapper>
