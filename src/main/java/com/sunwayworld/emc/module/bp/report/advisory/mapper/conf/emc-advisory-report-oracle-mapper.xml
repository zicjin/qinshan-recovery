<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.bp.report.advisory.mapper.EmcAdvisoryReportMapper">

    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM (SELECT A.*,
                       B.PROJNAME,
                       B.CREATEDBYNAME AS PROJUSERNAME,
                       B.ORGNAME,
                       B.TESTORGNAME,
                       B.ACCOUNTINGFLAG,
                       B.ENTRUSTORGNAME,
                       C.BIZCATEGORYNAME
                  FROM T_EMC_ADVISORY_REPORT A
                  LEFT JOIN T_EMC_PROJECT B
                    ON A.PROJID = B.ID
                  LEFT JOIN T_EMC_BIZ_CATEGORY C
                    ON B.BIZCATEGORYID = C.ID) T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>

</mapper>
