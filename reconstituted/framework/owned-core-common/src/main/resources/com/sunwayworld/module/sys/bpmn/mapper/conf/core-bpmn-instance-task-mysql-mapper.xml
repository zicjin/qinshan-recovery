<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.module.sys.bpmn.mapper.CoreBpmnInstanceTaskMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM T_CORE_BPMN_INST_TASK T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ID DESC
            </otherwise>
        </choose>
    </select>
    
    <select id="selectAuditableInstanceTaskList" resultType="map">
        SELECT T.*
          FROM T_CORE_BPMN_INST_TASK T
         WHERE T.STATUS IN ('CREATED', 'REJECTED')
           <if test="userId != null">
           AND (EXISTS (SELECT 1
                          FROM T_CORE_BPMN_INST_TASK_USER U
                         WHERE T.ID = U.INSTTASKID
                           AND U.USERID = #{userId})
                OR EXISTS (SELECT 1
                             FROM T_CORE_BPMN_INST_TASK_ROLE R, T_CORE_ROLE_USER U
                            WHERE T.ID = R.INSTTASKID
                              AND R.ROLEID = U.ROLEID
                              AND U.USERID = #{userId}))
           </if>
           AND T.INSTID IN
           <foreach collection="instIdList" item="instId"  separator="," open="(" close=")">
                #{instId}
           </foreach>
    </select>
</mapper>