<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sunwayworld.emc.module.mdm.basemdm.monitortmplgroup.mapper.PfMonitorTmplGroupMapper">
    <select id="selectByCondition" parameterType="map" resultType="map">
        SELECT T.*
          FROM T_EMC_MONITOR_TMPL_GROUP T
        <where>
            <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendWhereClausesIfPresent" />
            <if test="target_unassigned != null">
                AND NOT EXISTS (SELECT 1
                                  FROM ${targetTable} TAR_
                                 WHERE TAR_.${targetMonitorTmplGroupIdColumn} = T.ID
                                 <if test="targetFilterColumn != null">
                                     AND TAR_.${targetFilterColumn} = #{targetFilterValue}
                                 </if>
                                 <if test="targetFilterColumn1 != null">
                                     AND TAR_.${targetFilterColumn1} = #{targetFilterValue1}
                                 </if>
                                )
            </if>
            <if test='filter_monitorPointCategoryId != null'>
                and exists (
                    select
                    1
                    from
                    T_EMC_MONITOR_POINT_CATEGORY c
                    where
                    c.MONITORTMPLGROUPID = T.ID
                    and C.ID = #{filter_monitorPointCategoryId})
            </if>
            <if test='filter_activatedTmpl != null'>
                AND EXISTS (SELECT 1
                FROM T_EMC_MONITOR_TMPL A
                WHERE A.MONITORTMPLGROUPID = T.ID
                AND A.ORGID = #{loginUser.ext$.parentorgid}
                AND A.ACTIVATEDFLAG = '1')
            </if>
        </where>
        ORDER BY
        <choose>
            <when test="orderParams != null and orderParams.size > 0">
                <include refid="com.sunwayworld.framework.mybatis.mapper.GlobalMapper.appendOrderClause" />
            </when>
            <otherwise>
                T.ORDERNO ASC
            </otherwise>
        </choose>
    </select>


    <!-- 查询详情 -->
    <select id="selectDetail" parameterType="java.lang.Long" resultType="map">
        SELECT T.*
          FROM T_EMC_MONITOR_TMPL_GROUP T
         WHERE T.ID = #{id}
    </select>

</mapper>
